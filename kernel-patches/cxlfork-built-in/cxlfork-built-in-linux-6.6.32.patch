diff --git a/samples/cxlfork/cxlfork_context_demo.c b/samples/cxlfork/cxlfork_context_demo.c
new file mode 100644
index 000000000..a04a9bc2a
--- /dev/null
+++ b/samples/cxlfork/cxlfork_context_demo.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define CTX_BASE ((void *)0x776000000000ULL)
+#define CTX_LEN (4UL * 1024UL * 1024UL)
+#define CTX_STACK_OFF (1UL * 1024UL * 1024UL)
+#define CTX_STACK_SIZE (1UL * 1024UL * 1024UL)
+#define CTX_MAGIC 0x43584c4653544154ULL
+#define CTX_MARKER 0x5152535455565758ULL
+#define CTX_AFTER 0x8182838485868788ULL
+
+struct cxlfork_context_blob {
+	uint64_t magic;
+	uint64_t key;
+	uint64_t marker;
+	uint64_t resume_pid;
+	ucontext_t ctx;
+};
+
+static struct cxlfork_context_blob *blob_at_base(void)
+{
+	return (struct cxlfork_context_blob *)CTX_BASE;
+}
+
+static void resumed_entry(uintptr_t blob_addr)
+{
+	struct cxlfork_context_blob *blob = (void *)blob_addr;
+
+	if (blob->magic != CTX_MAGIC || blob->marker != CTX_MARKER) {
+		fprintf(stderr, "context resume verify failed magic=%016" PRIx64
+			" marker=%016" PRIx64 "\n", blob->magic, blob->marker);
+		exit(1);
+	}
+
+	blob->resume_pid = getpid();
+	blob->marker = CTX_AFTER;
+	printf("cxlfork_context_resumed key=%" PRIu64
+	       " pid=%ld marker=%016" PRIx64 " stack=%p verify=ok\n",
+	       blob->key, (long)getpid(), blob->marker, &blob_addr);
+	fflush(stdout);
+	exit(0);
+}
+
+static int map_context_region(void)
+{
+	void *addr;
+
+	addr = mmap(CTX_BASE, CTX_LEN, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (addr == MAP_FAILED) {
+		perror("mmap context");
+		return -1;
+	}
+	return 0;
+}
+
+static int do_prepare(uint64_t key)
+{
+	struct cxlfork_context_blob *blob;
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+	if (map_context_region()) {
+		close(fd);
+		return 1;
+	}
+
+	blob = blob_at_base();
+	memset(blob, 0, sizeof(*blob));
+	blob->magic = CTX_MAGIC;
+	blob->key = key;
+	blob->marker = CTX_MARKER;
+
+	if (getcontext(&blob->ctx)) {
+		perror("getcontext");
+		close(fd);
+		return 1;
+	}
+	blob->ctx.uc_stack.ss_sp = (char *)CTX_BASE + CTX_STACK_OFF;
+	blob->ctx.uc_stack.ss_size = CTX_STACK_SIZE;
+	blob->ctx.uc_link = NULL;
+	makecontext(&blob->ctx, (void (*)(void))resumed_entry, 1,
+		    (uintptr_t)blob);
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)CTX_BASE;
+	op.scan_end = (uintptr_t)CTX_BASE + CTX_LEN;
+	if (ioctl(fd, CXLFORK_FORK_PREPARE, &op)) {
+		perror("CXLFORK_FORK_PREPARE");
+		close(fd);
+		return 1;
+	}
+
+	printf("cxlfork_context_prepare key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " prepare_ns=%" PRIu64 " entry=%p stack=%p verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.checkpoint_ns,
+	       resumed_entry, blob->ctx.uc_stack.ss_sp);
+	close(fd);
+	return 0;
+}
+
+static int child_resume_context(uint64_t key)
+{
+	struct cxlfork_context_blob *blob = blob_at_base();
+	struct cxlfork_restore op;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW;
+	if (ioctl(fd, CXLFORK_FORK_RESUME, &op)) {
+		perror("CXLFORK_FORK_RESUME");
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	printf("cxlfork_context_resume_apply key=%" PRIu64
+	       " child_pid=%ld regions=%" PRIu64 " pages=%" PRIu64
+	       " resume_ns=%" PRIu64 "\n",
+	       key, (long)getpid(), op.nr_regions, op.total_pages, op.restore_ns);
+	fflush(stdout);
+	setcontext(&blob->ctx);
+	perror("setcontext");
+	return 1;
+}
+
+static int do_resume_child(uint64_t key)
+{
+	pid_t pid;
+	int status;
+
+	pid = fork();
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (pid == 0)
+		exit(child_resume_context(key));
+
+	if (waitpid(pid, &status, 0) != pid) {
+		perror("waitpid");
+		return 1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status))
+		return 1;
+	printf("cxlfork_context_parent key=%" PRIu64
+	       " child_pid=%ld status=ok\n", key, (long)pid);
+	return 0;
+}
+
+static int do_verify_original(uint64_t key)
+{
+	struct cxlfork_context_blob *blob = blob_at_base();
+	struct cxlfork_restore op;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		close(fd);
+		return 1;
+	}
+	if (blob->marker != CTX_MARKER) {
+		fprintf(stderr, "context checkpoint changed marker=%016" PRIx64
+			" want=%016" PRIx64 "\n", blob->marker, (uint64_t)CTX_MARKER);
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_context_verify_original key=%" PRIu64
+	       " marker=%016" PRIx64 " verify=ok\n", key, blob->marker);
+	close(fd);
+	return 0;
+}
+
+static void usage(const char *argv0)
+{
+	fprintf(stderr, "usage: %s prepare|resume-child|verify-original <key>\n",
+		argv0);
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+
+	if (argc < 3) {
+		usage(argv[0]);
+		return 2;
+	}
+	key = strtoull(argv[2], NULL, 0);
+
+	if (!strcmp(argv[1], "prepare"))
+		return do_prepare(key);
+	if (!strcmp(argv[1], "resume-child"))
+		return do_resume_child(key);
+	if (!strcmp(argv[1], "verify-original"))
+		return do_verify_original(key);
+
+	usage(argv[0]);
+	return 2;
+}
diff --git a/samples/cxlfork/cxlfork_demo.c b/samples/cxlfork/cxlfork_demo.c
new file mode 100644
index 000000000..5f5b52355
--- /dev/null
+++ b/samples/cxlfork/cxlfork_demo.c
@@ -0,0 +1,495 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define DATA_BASE ((void *)0x76a000000000ULL)
+#define DATA_GAP (64UL * 1024UL * 1024UL)
+#define MAX_MULTI_REGIONS 4
+#define DEFAULT_LEN (2UL * 1024UL * 1024UL)
+
+static uint64_t pattern(uint64_t index)
+{
+	return 0xc001f00d00000000ULL ^ (index * 0x9e3779b97f4a7c15ULL);
+}
+
+static void usage(const char *argv0)
+{
+	fprintf(stderr,
+		"usage: %s checkpoint|checkpoint-multi|restore|restore-cow|restore-shared-cow|restore-multi-shared-cow|restore-shared-write|restore-first|stats|release <key> [bytes] [value]\n",
+		argv0);
+}
+
+static size_t parse_len(int argc, char **argv)
+{
+	size_t len = DEFAULT_LEN;
+
+	if (argc >= 4)
+		len = strtoull(argv[3], NULL, 0);
+	len = (len + 4095UL) & ~4095UL;
+	return len;
+}
+
+static int fill_region(size_t len)
+{
+	uint64_t *data;
+	size_t words = len / sizeof(*data);
+	size_t i;
+
+	data = mmap(DATA_BASE, len, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (data == MAP_FAILED) {
+		perror("mmap");
+		return -1;
+	}
+
+	for (i = 0; i < words; i++)
+		data[i] = pattern(i);
+	return 0;
+}
+
+static void *multi_base(unsigned int region)
+{
+	return (void *)((uintptr_t)DATA_BASE + region * DATA_GAP);
+}
+
+static uint64_t multi_pattern(unsigned int region, uint64_t index)
+{
+	return pattern(index) ^ (0x1111111111111111ULL * (region + 1));
+}
+
+static int fill_one_multi_region(unsigned int region, size_t len)
+{
+	uint64_t *data;
+	size_t words = len / sizeof(*data);
+	size_t i;
+
+	data = mmap(multi_base(region), len, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (data == MAP_FAILED) {
+		perror("mmap multi");
+		return -1;
+	}
+
+	for (i = 0; i < words; i++)
+		data[i] = multi_pattern(region, i);
+	return 0;
+}
+
+static int verify_one_multi_region(unsigned int region, size_t len)
+{
+	volatile uint64_t *data = multi_base(region);
+	size_t words = len / sizeof(*data);
+	size_t step = 4096 / sizeof(*data);
+	size_t i;
+
+	for (i = 0; i < words; i += step) {
+		uint64_t got = data[i];
+		uint64_t want = multi_pattern(region, i);
+
+		if (got != want) {
+			fprintf(stderr,
+				"multi verify failed region=%u word=%zu got=%016" PRIx64
+				" want=%016" PRIx64 "\n",
+				region, i, got, want);
+			return -1;
+		}
+	}
+
+	if (words) {
+		uint64_t got = data[words - 1];
+		uint64_t want = multi_pattern(region, words - 1);
+
+		if (got != want) {
+			fprintf(stderr,
+				"multi verify failed region=%u last got=%016" PRIx64
+				" want=%016" PRIx64 "\n",
+				region, got, want);
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int fill_multi_regions(unsigned int regions, size_t len)
+{
+	unsigned int i;
+
+	for (i = 0; i < regions; i++) {
+		if (fill_one_multi_region(i, len))
+			return -1;
+	}
+	return 0;
+}
+
+static int verify_multi_regions(unsigned int regions, size_t len)
+{
+	unsigned int i;
+
+	for (i = 0; i < regions; i++) {
+		if (verify_one_multi_region(i, len))
+			return -1;
+	}
+	return 0;
+}
+
+static int verify_region(size_t len)
+{
+	volatile uint64_t *data = DATA_BASE;
+	size_t words = len / sizeof(*data);
+	size_t step = 4096 / sizeof(*data);
+	size_t i;
+
+	for (i = 0; i < words; i += step) {
+		uint64_t got = data[i];
+		uint64_t want = pattern(i);
+
+		if (got != want) {
+			fprintf(stderr,
+				"verify failed at word=%zu got=%016" PRIx64
+				" want=%016" PRIx64 "\n",
+				i, got, want);
+			return -1;
+		}
+	}
+
+	if (words) {
+		uint64_t got = data[words - 1];
+		uint64_t want = pattern(words - 1);
+
+		if (got != want) {
+			fprintf(stderr,
+				"verify failed at last got=%016" PRIx64
+				" want=%016" PRIx64 "\n",
+				got, want);
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int do_checkpoint(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+
+	if (fill_region(len))
+		return 1;
+	if (verify_region(len))
+		return 1;
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)DATA_BASE;
+	op.scan_end = (uintptr_t)DATA_BASE + len;
+
+	if (ioctl(fd, CXLFORK_CHECKPOINT, &op)) {
+		perror("CXLFORK_CHECKPOINT");
+		return 1;
+	}
+	printf("cxlfork_checkpoint key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " checkpoint_ns=%" PRIu64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.checkpoint_ns);
+	return 0;
+}
+
+static int do_checkpoint_multi(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	unsigned int regions = MAX_MULTI_REGIONS;
+
+	if (fill_multi_regions(regions, len))
+		return 1;
+	if (verify_multi_regions(regions, len))
+		return 1;
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)multi_base(0);
+	op.scan_end = (uintptr_t)multi_base(regions - 1) + len;
+
+	if (ioctl(fd, CXLFORK_CHECKPOINT, &op)) {
+		perror("CXLFORK_CHECKPOINT");
+		return 1;
+	}
+	if (op.nr_regions != regions) {
+		fprintf(stderr, "checkpoint-multi region mismatch got=%" PRIu64
+			" want=%u\n", op.nr_regions, regions);
+		return 1;
+	}
+	printf("cxlfork_checkpoint_multi key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " checkpoint_ns=%" PRIu64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.checkpoint_ns);
+	return 0;
+}
+
+static int do_restore(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_restore op;
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		return 1;
+	}
+	if (verify_region(len))
+		return 1;
+
+	printf("cxlfork_restore key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " restore_ns=%" PRIu64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.restore_ns);
+	return 0;
+}
+
+static int do_restore_cow(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_restore op;
+	volatile uint64_t *data = DATA_BASE;
+	uint64_t before;
+	uint64_t after = 0xfeedfacecafebeefULL;
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_PRIVATE_COW;
+
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		return 1;
+	}
+	if (verify_region(len))
+		return 1;
+
+	before = data[0];
+	data[0] = after;
+	if (data[0] != after) {
+		fprintf(stderr, "cow write failed\n");
+		return 1;
+	}
+	printf("cxlfork_restore_cow key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " restore_ns=%" PRIu64 " before=%016" PRIx64
+	       " after=%016" PRIx64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.restore_ns, before, data[0]);
+	return 0;
+}
+
+static int do_restore_shared_write(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_restore op;
+	volatile uint64_t *data = DATA_BASE;
+	uint64_t before;
+	uint64_t after = 0xfeedfacecafebeefULL;
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		return 1;
+	}
+	if (verify_region(len))
+		return 1;
+
+	before = data[0];
+	data[0] = after;
+	if (data[0] != after) {
+		fprintf(stderr, "shared write failed\n");
+		return 1;
+	}
+	printf("cxlfork_restore_shared_write key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " restore_ns=%" PRIu64 " before=%016" PRIx64
+	       " after=%016" PRIx64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.restore_ns, before, data[0]);
+	return 0;
+}
+
+static int do_restore_shared_cow(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_restore op;
+	volatile uint64_t *data = DATA_BASE;
+	uint64_t before;
+	uint64_t after = 0xfeedfacecafebeefULL;
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW;
+
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		return 1;
+	}
+	if (verify_region(len))
+		return 1;
+
+	before = data[0];
+	data[0] = after;
+	if (data[0] != after) {
+		fprintf(stderr, "shared cow write failed\n");
+		return 1;
+	}
+	printf("cxlfork_restore_shared_cow key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " restore_ns=%" PRIu64 " before=%016" PRIx64
+	       " after=%016" PRIx64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.restore_ns, before, data[0]);
+	return 0;
+}
+
+static int do_restore_multi_shared_cow(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_restore op;
+	unsigned int regions = MAX_MULTI_REGIONS;
+	unsigned int i;
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW;
+
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		return 1;
+	}
+	if (op.nr_regions != regions) {
+		fprintf(stderr, "restore-multi region mismatch got=%" PRIu64
+			" want=%u\n", op.nr_regions, regions);
+		return 1;
+	}
+	if (verify_multi_regions(regions, len))
+		return 1;
+
+	for (i = 0; i < regions; i++) {
+		volatile uint64_t *data = multi_base(i);
+		uint64_t after = 0xfeedfacecafebeefULL ^ i;
+
+		data[0] = after;
+		if (data[0] != after) {
+			fprintf(stderr, "multi shared cow write failed region=%u\n", i);
+			return 1;
+		}
+	}
+	printf("cxlfork_restore_multi_shared_cow key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " restore_ns=%" PRIu64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.restore_ns);
+	return 0;
+}
+
+static int do_restore_first(int fd, uint64_t key, uint64_t want)
+{
+	struct cxlfork_restore op;
+	volatile uint64_t *data = DATA_BASE;
+	uint64_t got;
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		return 1;
+	}
+
+	got = data[0];
+	if (got != want) {
+		fprintf(stderr, "first-word mismatch got=%016" PRIx64
+			" want=%016" PRIx64 "\n", got, want);
+		return 1;
+	}
+	printf("cxlfork_restore_first key=%" PRIu64
+	       " first=%016" PRIx64 " verify=ok\n", key, got);
+	return 0;
+}
+
+static int do_stats(int fd, uint64_t key)
+{
+	struct cxlfork_stats st;
+
+	memset(&st, 0, sizeof(st));
+	st.key = key;
+	if (ioctl(fd, CXLFORK_STATS, &st)) {
+		perror("CXLFORK_STATS");
+		return 1;
+	}
+	printf("cxlfork_stats key=%" PRIu64 " ready=%" PRIu64
+	       " slot=%" PRIu64 " regions=%" PRIu64
+	       " pages=%" PRIu64 " faults=%" PRIu64 "\n",
+	       key, st.ready, st.slot, st.nr_regions, st.total_pages,
+	       st.faults);
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+	size_t len;
+	int fd;
+	int ret;
+
+	if (argc < 3) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	key = strtoull(argv[2], NULL, 0);
+	len = parse_len(argc, argv);
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	if (!strcmp(argv[1], "checkpoint"))
+		ret = do_checkpoint(fd, key, len);
+	else if (!strcmp(argv[1], "checkpoint-multi"))
+		ret = do_checkpoint_multi(fd, key, len);
+	else if (!strcmp(argv[1], "restore"))
+		ret = do_restore(fd, key, len);
+	else if (!strcmp(argv[1], "restore-cow"))
+		ret = do_restore_cow(fd, key, len);
+	else if (!strcmp(argv[1], "restore-shared-cow"))
+		ret = do_restore_shared_cow(fd, key, len);
+	else if (!strcmp(argv[1], "restore-multi-shared-cow"))
+		ret = do_restore_multi_shared_cow(fd, key, len);
+	else if (!strcmp(argv[1], "restore-shared-write"))
+		ret = do_restore_shared_write(fd, key, len);
+	else if (!strcmp(argv[1], "restore-first")) {
+		uint64_t want = argc >= 5 ? strtoull(argv[4], NULL, 0) : pattern(0);
+
+		ret = do_restore_first(fd, key, want);
+	}
+	else if (!strcmp(argv[1], "stats"))
+		ret = do_stats(fd, key);
+	else if (!strcmp(argv[1], "release")) {
+		struct cxlfork_release rel = { .key = key };
+
+		ret = ioctl(fd, CXLFORK_RELEASE, &rel) ? 1 : 0;
+		if (ret)
+			perror("CXLFORK_RELEASE");
+	} else {
+		usage(argv[0]);
+		ret = 2;
+	}
+
+	close(fd);
+	return ret;
+}
diff --git a/samples/cxlfork/cxlfork_fork_demo.c b/samples/cxlfork/cxlfork_fork_demo.c
new file mode 100644
index 000000000..84b3c4cee
--- /dev/null
+++ b/samples/cxlfork/cxlfork_fork_demo.c
@@ -0,0 +1,352 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/syscall.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define FORK_BASE ((void *)0x775000000000ULL)
+#define FORK_LEN_DEFAULT (2UL * 1024UL * 1024UL)
+
+static uint64_t fork_pattern(uint64_t index)
+{
+	return 0xf047000000000000ULL ^ (index * 0x9e3779b97f4a7c15ULL);
+}
+
+static size_t parse_len(int argc, char **argv)
+{
+	size_t len = FORK_LEN_DEFAULT;
+
+	if (argc >= 4)
+		len = strtoull(argv[3], NULL, 0);
+	return (len + 4095UL) & ~4095UL;
+}
+
+static int fill_working_set(size_t len)
+{
+	uint64_t *data;
+	size_t words = len / sizeof(*data);
+	size_t i;
+
+	data = mmap(FORK_BASE, len, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (data == MAP_FAILED) {
+		perror("mmap");
+		return -1;
+	}
+
+	for (i = 0; i < words; i++)
+		data[i] = fork_pattern(i);
+	return 0;
+}
+
+static int verify_working_set(size_t len)
+{
+	volatile uint64_t *data = FORK_BASE;
+	size_t words = len / sizeof(*data);
+	size_t step = 4096 / sizeof(*data);
+	size_t i;
+
+	for (i = 0; i < words; i += step) {
+		uint64_t got = data[i];
+		uint64_t want = fork_pattern(i);
+
+		if (got != want) {
+			fprintf(stderr, "verify failed word=%zu got=%016" PRIx64
+				" want=%016" PRIx64 "\n", i, got, want);
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int do_prepare(uint64_t key, size_t len)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	int held_fd;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	if (fill_working_set(len) || verify_working_set(len)) {
+		close(fd);
+		return 1;
+	}
+	held_fd = open("/etc/hostname", O_RDONLY);
+	if (held_fd < 0) {
+		perror("open fd-state probe");
+		close(fd);
+		return 1;
+	}
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)FORK_BASE;
+	op.scan_end = (uintptr_t)FORK_BASE + len;
+	if (ioctl(fd, CXLFORK_FORK_PREPARE, &op)) {
+		perror("CXLFORK_FORK_PREPARE");
+		close(held_fd);
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_fork_prepare key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " prepare_ns=%" PRIu64 " pid=%ld mm_pid=%u brk=%016" PRIx64
+	       " stack=%016" PRIx64 " fds=%" PRIu64 " fd0=%u path0=%.*s"
+	       " regs_ip=%016" PRIx64 " regs_sp=%016" PRIx64
+	       " fsbase=%016" PRIx64 " comm=%.*s verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.checkpoint_ns, (long)getpid(),
+	       op.mm_state.pid, op.mm_state.brk, op.mm_state.start_stack,
+	       op.nr_fds, op.nr_fds ? op.fds[0].fd : 0,
+	       CXLFORK_PATH_LEN, op.nr_fds ? (char *)op.fds[0].path : "",
+	       op.thread_state.ip, op.thread_state.sp, op.thread_state.fsbase,
+	       CXLFORK_COMM_LEN, op.mm_state.comm);
+	close(held_fd);
+	close(fd);
+	return 0;
+}
+
+static int read_self_comm(char *buf, size_t len)
+{
+	int fd;
+	ssize_t n;
+
+	fd = open("/proc/self/comm", O_RDONLY);
+	if (fd < 0)
+		return -1;
+	n = read(fd, buf, len - 1);
+	close(fd);
+	if (n < 0)
+		return -1;
+	while (n > 0 && (buf[n - 1] == '\n' || buf[n - 1] == '\0'))
+		n--;
+	buf[n] = '\0';
+	return 0;
+}
+
+static int child_resume_and_run(uint64_t key, size_t len, int apply_mm_state,
+				int reopen_fds)
+{
+	struct cxlfork_restore op;
+	volatile uint64_t *data = FORK_BASE;
+	uint64_t before;
+	uint64_t after = 0xabcddcba12344321ULL;
+	unsigned long child_brk_after;
+	char comm_after[CXLFORK_COMM_LEN];
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW;
+	if (apply_mm_state)
+		op.flags |= CXLFORK_F_APPLY_MM_STATE;
+	if (reopen_fds)
+		op.flags |= CXLFORK_F_REOPEN_FDS;
+	if (ioctl(fd, CXLFORK_FORK_RESUME, &op)) {
+		perror("CXLFORK_FORK_RESUME");
+		close(fd);
+		return 1;
+	}
+	if (!op.mm_state.pid || !op.mm_state.start_stack) {
+		fprintf(stderr, "missing restored mm state pid=%u stack=%016" PRIx64 "\n",
+			op.mm_state.pid, op.mm_state.start_stack);
+		close(fd);
+		return 1;
+	}
+	if (!op.thread_state.ip || !op.thread_state.sp) {
+		fprintf(stderr, "missing restored thread state ip=%016" PRIx64
+			" sp=%016" PRIx64 "\n",
+			op.thread_state.ip, op.thread_state.sp);
+		close(fd);
+		return 1;
+	}
+	if (!op.nr_fds) {
+		fprintf(stderr, "missing restored fd state\n");
+		close(fd);
+		return 1;
+	}
+	child_brk_after = syscall(SYS_brk, 0);
+	if (apply_mm_state && child_brk_after != op.mm_state.brk) {
+		fprintf(stderr, "brk apply failed got=%016lx want=%016" PRIx64 "\n",
+			child_brk_after, op.mm_state.brk);
+		close(fd);
+		return 1;
+	}
+	if (read_self_comm(comm_after, sizeof(comm_after))) {
+		perror("read comm");
+		close(fd);
+		return 1;
+	}
+	if (apply_mm_state &&
+	    strncmp(comm_after, (char *)op.mm_state.comm, sizeof(comm_after))) {
+		fprintf(stderr, "comm apply failed got=%s want=%.*s\n",
+			comm_after, CXLFORK_COMM_LEN, op.mm_state.comm);
+		close(fd);
+		return 1;
+	}
+	if (reopen_fds && !op.nr_fds_restored) {
+		fprintf(stderr, "fd reopen failed serialized=%" PRIu64 "\n",
+			op.nr_fds);
+		close(fd);
+		return 1;
+	}
+
+	if (verify_working_set(len)) {
+		close(fd);
+		return 1;
+	}
+	before = data[0];
+	data[0] = after;
+	if (data[0] != after) {
+		fprintf(stderr, "child write failed\n");
+		close(fd);
+		return 1;
+	}
+
+	printf("cxlfork_fork_resume_child key=%" PRIu64
+	       " child_pid=%ld regions=%" PRIu64 " pages=%" PRIu64
+	       " resume_ns=%" PRIu64 " before=%016" PRIx64
+	       " after=%016" PRIx64 " mm_pid=%u brk=%016" PRIx64
+	       " stack=%016" PRIx64 " fds=%" PRIu64 " fd0=%u path0=%.*s"
+	       " restored_fds=%" PRIu64 " comm=%.*s child_brk=%016lx"
+	       " child_comm=%s regs_ip=%016" PRIx64 " regs_sp=%016" PRIx64
+	       " fsbase=%016" PRIx64 " apply_mm=%d reopen_fds=%d verify=ok\n",
+	       key, (long)getpid(), op.nr_regions, op.total_pages,
+	       op.restore_ns, before, data[0], op.mm_state.pid, op.mm_state.brk,
+	       op.mm_state.start_stack, op.nr_fds, op.fds[0].fd,
+	       CXLFORK_PATH_LEN, (char *)op.fds[0].path, op.nr_fds_restored,
+	       CXLFORK_COMM_LEN, op.mm_state.comm, child_brk_after, comm_after,
+	       op.thread_state.ip, op.thread_state.sp, op.thread_state.fsbase,
+	       apply_mm_state, reopen_fds);
+	close(fd);
+	return 0;
+}
+
+static int do_resume_child(uint64_t key, size_t len, int apply_mm_state,
+			   int reopen_fds)
+{
+	struct timespec start;
+	struct timespec end;
+	uint64_t invoke_ns;
+	pid_t pid;
+	int status;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &start)) {
+		perror("clock_gettime");
+		return 1;
+	}
+	pid = fork();
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (pid == 0)
+		exit(child_resume_and_run(key, len, apply_mm_state, reopen_fds));
+
+	if (waitpid(pid, &status, 0) != pid) {
+		perror("waitpid");
+		return 1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status))
+		return 1;
+	if (clock_gettime(CLOCK_MONOTONIC, &end)) {
+		perror("clock_gettime");
+		return 1;
+	}
+	invoke_ns = (uint64_t)(end.tv_sec - start.tv_sec) * 1000000000ULL +
+		    (uint64_t)(end.tv_nsec - start.tv_nsec);
+	printf("cxlfork_fork_resume_parent key=%" PRIu64
+	       " child_pid=%ld invoke_ns=%" PRIu64 " status=ok\n",
+	       key, (long)pid, invoke_ns);
+	return 0;
+}
+
+static int do_verify_original(uint64_t key)
+{
+	struct cxlfork_restore op;
+	volatile uint64_t *data = FORK_BASE;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		close(fd);
+		return 1;
+	}
+	if (data[0] != fork_pattern(0)) {
+		fprintf(stderr, "checkpoint changed got=%016" PRIx64
+			" want=%016" PRIx64 "\n", data[0], fork_pattern(0));
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_fork_verify_original key=%" PRIu64
+	       " first=%016" PRIx64 " verify=ok\n", key, data[0]);
+	close(fd);
+	return 0;
+}
+
+static void usage(const char *argv0)
+{
+	fprintf(stderr,
+		"usage: %s prepare|resume-child|resume-child-apply-mm|resume-child-reopen-fds|verify-original <key> [bytes]\n",
+		argv0);
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+	size_t len;
+
+	if (argc < 3) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	key = strtoull(argv[2], NULL, 0);
+	len = parse_len(argc, argv);
+
+	if (!strcmp(argv[1], "prepare"))
+		return do_prepare(key, len);
+	if (!strcmp(argv[1], "resume-child"))
+		return do_resume_child(key, len, 0, 0);
+	if (!strcmp(argv[1], "resume-child-apply-mm"))
+		return do_resume_child(key, len, 1, 0);
+	if (!strcmp(argv[1], "resume-child-reopen-fds"))
+		return do_resume_child(key, len, 1, 1);
+	if (!strcmp(argv[1], "verify-original"))
+		return do_verify_original(key);
+
+	usage(argv[0]);
+	return 2;
+}
diff --git a/samples/cxlfork/cxlfork_global_demo.c b/samples/cxlfork/cxlfork_global_demo.c
new file mode 100644
index 000000000..b60c4b351
--- /dev/null
+++ b/samples/cxlfork/cxlfork_global_demo.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _POSIX_C_SOURCE 200809L
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define GLOBAL_BASE ((void *)0x777000000000ULL)
+#define GLOBAL_LEN 4096UL
+#define GLOBAL_FD 77
+
+static void die(const char *msg)
+{
+	perror(msg);
+	exit(1);
+}
+
+static uint64_t nsec_now(void)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return (uint64_t)tv.tv_sec * 1000000000ULL + (uint64_t)tv.tv_usec * 1000ULL;
+}
+
+static void map_payload(void)
+{
+	uint64_t *p;
+
+	p = mmap(GLOBAL_BASE, GLOBAL_LEN, PROT_READ | PROT_WRITE,
+		 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (p == MAP_FAILED)
+		die("mmap");
+	*p = 0xc6840b1a15ULL;
+}
+
+static int prepare(uint64_t key, const char *dir, const char *file)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	struct rlimit rl = { .rlim_cur = 777, .rlim_max = 777 };
+	stack_t ss;
+	sigset_t mask;
+	char *stack;
+	int fd;
+	int devfd;
+
+	if (chdir(dir))
+		die("chdir prepare");
+	umask(0027);
+	if (setrlimit(RLIMIT_NOFILE, &rl))
+		die("setrlimit prepare");
+	sigemptyset(&mask);
+	sigaddset(&mask, SIGUSR1);
+	if (sigprocmask(SIG_SETMASK, &mask, NULL))
+		die("sigprocmask prepare");
+	stack = mmap(NULL, SIGSTKSZ, PROT_READ | PROT_WRITE,
+		     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (stack == MAP_FAILED)
+		die("mmap sigaltstack");
+	memset(&ss, 0, sizeof(ss));
+	ss.ss_sp = stack;
+	ss.ss_size = SIGSTKSZ;
+	if (sigaltstack(&ss, NULL))
+		die("sigaltstack prepare");
+	fd = open(file, O_RDWR | O_CREAT, 0644);
+	if (fd < 0)
+		die("open prepare");
+	if (dup2(fd, GLOBAL_FD) != GLOBAL_FD)
+		die("dup2 prepare");
+	if (fd != GLOBAL_FD)
+		close(fd);
+	if (write(GLOBAL_FD, "global-state\n", 13) != 13)
+		die("write prepare");
+	if (lseek(GLOBAL_FD, 0, SEEK_SET) < 0)
+		die("lseek prepare");
+
+	map_payload();
+	devfd = open(CXLFORK_DEVICE, O_RDWR);
+	if (devfd < 0)
+		die(CXLFORK_DEVICE);
+	(void)ioctl(devfd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)GLOBAL_BASE;
+	op.scan_end = (uintptr_t)GLOBAL_BASE + GLOBAL_LEN;
+	if (ioctl(devfd, CXLFORK_FORK_PREPARE, &op))
+		die("CXLFORK_FORK_PREPARE");
+	printf("cxlfork_global_prepare key=%" PRIu64
+	       " checkpoint_ns=%" PRIu64 " global_checkpoint_ns=%" PRIu64
+	       " cwd=%s umask=%03o fd=%d mnt_ns=%" PRIu64
+	       " pid_ns=%" PRIu64 " pid_ns_level=%u net_ns=%" PRIu64
+	       " cgroup_ns=%" PRIu64 " ns_flags=0x%x verify=ok\n",
+	       key, op.checkpoint_ns, op.global_checkpoint_ns,
+	       op.global_state.cwd, op.global_state.umask, GLOBAL_FD,
+	       op.global_state.ns_state.mnt_ns,
+	       op.global_state.ns_state.pid_ns,
+	       op.global_state.ns_state.pid_ns_level,
+	       op.global_state.ns_state.net_ns,
+	       op.global_state.ns_state.cgroup_ns,
+	       op.global_state.ns_state.flags);
+	close(devfd);
+	return 0;
+}
+
+static int resume(uint64_t key, const char *dir)
+{
+	struct cxlfork_restore op;
+	struct rlimit rl;
+	stack_t ss;
+	sigset_t mask;
+	char cwd[CXLFORK_PATH_LEN];
+	uint64_t begin;
+	int devfd;
+	mode_t old_umask;
+
+	if (chdir("/"))
+		die("chdir reset");
+	umask(0077);
+	rl.rlim_cur = 64;
+	rl.rlim_max = 64;
+	(void)setrlimit(RLIMIT_NOFILE, &rl);
+	sigemptyset(&mask);
+	(void)sigprocmask(SIG_SETMASK, &mask, NULL);
+	memset(&ss, 0, sizeof(ss));
+	ss.ss_flags = SS_DISABLE;
+	(void)sigaltstack(&ss, NULL);
+
+	devfd = open(CXLFORK_DEVICE, O_RDWR);
+	if (devfd < 0)
+		die(CXLFORK_DEVICE);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW | CXLFORK_F_APPLY_MM_STATE |
+		   CXLFORK_F_APPLY_GLOBAL_STATE | CXLFORK_F_REOPEN_FDS;
+	begin = nsec_now();
+	if (ioctl(devfd, CXLFORK_FORK_RESUME, &op))
+		die("CXLFORK_FORK_RESUME");
+	if (!op.restore_ns)
+		op.restore_ns = nsec_now() - begin;
+	if (!getcwd(cwd, sizeof(cwd)))
+		die("getcwd");
+	if (strcmp(cwd, dir)) {
+		fprintf(stderr, "cwd mismatch got=%s want=%s\n", cwd, dir);
+		return 1;
+	}
+	old_umask = umask(0022);
+	(void)umask(old_umask);
+	if (old_umask != 0027) {
+		fprintf(stderr, "umask mismatch got=%03o\n", old_umask);
+		return 1;
+	}
+	if (getrlimit(RLIMIT_NOFILE, &rl) || rl.rlim_cur != 777) {
+		fprintf(stderr, "rlimit mismatch cur=%llu\n",
+			(unsigned long long)rl.rlim_cur);
+		return 1;
+	}
+	if (sigprocmask(SIG_SETMASK, NULL, &mask) || !sigismember(&mask, SIGUSR1)) {
+		fprintf(stderr, "sigmask mismatch\n");
+		return 1;
+	}
+	if (sigaltstack(NULL, &ss) || ss.ss_size != SIGSTKSZ || (ss.ss_flags & SS_DISABLE)) {
+		fprintf(stderr, "sigaltstack mismatch size=%zu flags=0x%x\n",
+			ss.ss_size, ss.ss_flags);
+		return 1;
+	}
+	if (op.nr_fds_restored < 1) {
+		fprintf(stderr, "fd restore count mismatch got=%" PRIu64 "\n",
+			op.nr_fds_restored);
+		return 1;
+	}
+	printf("cxlfork_global_resume key=%" PRIu64
+	       " restore_ns=%" PRIu64 " global_restore_ns=%" PRIu64
+	       " fds_restored=%" PRIu64 " cwd=%s umask=%03o"
+	       " rlimit=%llu sigmask=ok altstack=ok fd_state=ok"
+	       " checkpoint_mnt_ns=%" PRIu64 " restore_mnt_ns=%" PRIu64
+	       " checkpoint_pid_ns=%" PRIu64 " restore_pid_ns=%" PRIu64
+	       " restore_net_ns=%" PRIu64 " restore_cgroup_ns=%" PRIu64
+	       " ns_flags=0x%x verify=ok\n",
+	       key, op.restore_ns, op.global_restore_ns, op.nr_fds_restored,
+	       cwd, old_umask, (unsigned long long)rl.rlim_cur,
+	       op.global_state.ns_state.mnt_ns,
+	       op.restore_ns_state.mnt_ns,
+	       op.global_state.ns_state.pid_ns,
+	       op.restore_ns_state.pid_ns,
+	       op.restore_ns_state.net_ns,
+	       op.restore_ns_state.cgroup_ns,
+	       op.restore_ns_state.flags);
+	close(devfd);
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+
+	if (argc != 5) {
+		fprintf(stderr, "usage: %s prepare|resume <key> <dir> <file>\n", argv[0]);
+		return 2;
+	}
+	key = strtoull(argv[2], NULL, 0);
+	if (!strcmp(argv[1], "prepare"))
+		return prepare(key, argv[3], argv[4]);
+	if (!strcmp(argv[1], "resume"))
+		return resume(key, argv[3]);
+	fprintf(stderr, "bad command: %s\n", argv[1]);
+	return 2;
+}
diff --git a/samples/cxlfork/cxlfork_regs_demo.c b/samples/cxlfork/cxlfork_regs_demo.c
new file mode 100644
index 000000000..937897c98
--- /dev/null
+++ b/samples/cxlfork/cxlfork_regs_demo.c
@@ -0,0 +1,304 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/syscall.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#ifndef ARCH_GET_FS
+#define ARCH_GET_FS 0x1003
+#endif
+
+#define REGS_BASE ((void *)0x777000000000ULL)
+#define REGS_LEN (2UL * 1024UL * 1024UL)
+#define REGS_STACK_OFF (1UL * 1024UL * 1024UL)
+#define REGS_STACK_SIZE (512UL * 1024UL)
+#define REGS_TLS_OFF (1536UL * 1024UL)
+#define REGS_MAGIC 0x43584c4652454753ULL
+#define REGS_DONE 0x444f4e4552454753ULL
+#define REGS_TLS_DONE 0x544c53444f4e4521ULL
+
+struct regs_blob {
+	uint64_t magic;
+	uint64_t key;
+	uint64_t marker;
+	uint64_t pid;
+	uint64_t tls_expected;
+	uint64_t tls_observed;
+};
+
+static struct regs_blob *blob_at_base(void)
+{
+	return (struct regs_blob *)REGS_BASE;
+}
+
+static long raw_syscall1(long nr, long a0)
+{
+	long ret;
+
+	asm volatile("syscall"
+		     : "=a"(ret)
+		     : "a"(nr), "D"(a0)
+		     : "rcx", "r11", "memory");
+	return ret;
+}
+
+static long raw_syscall2(long nr, long a0, long a1)
+{
+	long ret;
+
+	asm volatile("syscall"
+		     : "=a"(ret)
+		     : "a"(nr), "D"(a0), "S"(a1)
+		     : "rcx", "r11", "memory");
+	return ret;
+}
+
+static long raw_syscall3(long nr, long a0, long a1, long a2)
+{
+	long ret;
+
+	asm volatile("syscall"
+		     : "=a"(ret)
+		     : "a"(nr), "D"(a0), "S"(a1), "d"(a2)
+		     : "rcx", "r11", "memory");
+	return ret;
+}
+
+__attribute__((noreturn)) static void regs_resume_entry(uintptr_t blob_addr)
+{
+	struct regs_blob *blob = (void *)blob_addr;
+	uint64_t fs = 0;
+	static const char tls_ok[] = "cxlfork_regs_tls_resumed verify=ok\n";
+
+	if (blob->magic != REGS_MAGIC || blob->key == 0) {
+		_exit(101);
+	}
+	if (blob->tls_expected) {
+		raw_syscall2(SYS_arch_prctl, ARCH_GET_FS, (long)&fs);
+		blob->tls_observed = fs;
+		if (fs != blob->tls_expected)
+			raw_syscall1(SYS_exit, 102);
+		blob->pid = raw_syscall1(SYS_getpid, 0);
+		blob->marker = REGS_TLS_DONE;
+		raw_syscall3(SYS_write, STDOUT_FILENO, (long)tls_ok,
+			     sizeof(tls_ok) - 1);
+		raw_syscall1(SYS_exit, 0);
+		__builtin_unreachable();
+	}
+	blob->pid = getpid();
+	blob->marker = REGS_DONE;
+	printf("cxlfork_regs_resumed key=%" PRIu64 " pid=%ld marker=%016" PRIx64
+	       " stack=%p verify=ok\n",
+	       blob->key, (long)getpid(), blob->marker, &blob_addr);
+	fflush(stdout);
+	_exit(0);
+}
+
+static int map_regs_region(void)
+{
+	void *addr;
+
+	addr = mmap(REGS_BASE, REGS_LEN, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (addr == MAP_FAILED) {
+		perror("mmap regs");
+		return -1;
+	}
+	return 0;
+}
+
+static int do_prepare(uint64_t key, int tls_mode)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	struct regs_blob *blob;
+	uintptr_t stack_top;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+	if (map_regs_region()) {
+		close(fd);
+		return 1;
+	}
+
+	blob = blob_at_base();
+	memset(blob, 0, sizeof(*blob));
+	blob->magic = REGS_MAGIC;
+	blob->key = key;
+	if (tls_mode)
+		blob->tls_expected = (uintptr_t)REGS_BASE + REGS_TLS_OFF;
+	stack_top = (uintptr_t)REGS_BASE + REGS_STACK_OFF + REGS_STACK_SIZE - 16;
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)REGS_BASE;
+	op.scan_end = (uintptr_t)REGS_BASE + REGS_LEN;
+	op.flags = CXLFORK_F_USER_THREAD_STATE;
+	op.thread_state.ip = (uintptr_t)regs_resume_entry;
+	op.thread_state.sp = stack_top;
+	op.thread_state.di = (uintptr_t)REGS_BASE;
+	if (tls_mode)
+		op.thread_state.fsbase = blob->tls_expected;
+
+	if (ioctl(fd, CXLFORK_FORK_PREPARE, &op)) {
+		perror("CXLFORK_FORK_PREPARE");
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_regs_prepare key=%" PRIu64 " entry=%016" PRIx64
+	       " sp=%016" PRIx64 " arg=%016" PRIx64
+	       " fsbase=%016" PRIx64 " pages=%" PRIu64
+	       " prepare_ns=%" PRIu64 " tls=%d verify=ok\n",
+	       key, op.thread_state.ip, op.thread_state.sp, op.thread_state.di,
+	       op.thread_state.fsbase, op.total_pages, op.checkpoint_ns, tls_mode);
+	close(fd);
+	return 0;
+}
+
+static int child_resume_regs(uint64_t key, int tls_mode)
+{
+	struct cxlfork_restore op;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW | CXLFORK_F_APPLY_THREAD_STATE;
+	if (tls_mode)
+		op.flags |= CXLFORK_F_APPLY_TLS_STATE;
+	if (ioctl(fd, CXLFORK_FORK_RESUME, &op)) {
+		perror("CXLFORK_FORK_RESUME");
+		close(fd);
+		return 1;
+	}
+
+	/*
+	 * On success the syscall return path should use the restored pt_regs
+	 * and never execute this user instruction stream again.
+	 */
+	fprintf(stderr, "unexpected return after APPLY_THREAD_STATE\n");
+	close(fd);
+	return 1;
+}
+
+static int do_resume_child(uint64_t key, int tls_mode)
+{
+	struct timespec start;
+	struct timespec end;
+	uint64_t invoke_ns;
+	pid_t pid;
+	int status;
+
+	if (clock_gettime(CLOCK_MONOTONIC, &start)) {
+		perror("clock_gettime");
+		return 1;
+	}
+	pid = fork();
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (pid == 0)
+		_exit(child_resume_regs(key, tls_mode));
+
+	if (waitpid(pid, &status, 0) != pid) {
+		perror("waitpid");
+		return 1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status))
+		return 1;
+	if (clock_gettime(CLOCK_MONOTONIC, &end)) {
+		perror("clock_gettime");
+		return 1;
+	}
+	invoke_ns = (uint64_t)(end.tv_sec - start.tv_sec) * 1000000000ULL +
+		    (uint64_t)(end.tv_nsec - start.tv_nsec);
+	printf("cxlfork_regs_parent key=%" PRIu64
+	       " child_pid=%ld invoke_ns=%" PRIu64 " status=ok\n",
+	       key, (long)pid, invoke_ns);
+	return 0;
+}
+
+static int do_verify_original(uint64_t key)
+{
+	struct cxlfork_restore op;
+	struct regs_blob *blob = blob_at_base();
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		close(fd);
+		return 1;
+	}
+	if (blob->marker != 0) {
+		fprintf(stderr, "regs checkpoint changed marker=%016" PRIx64 "\n",
+			blob->marker);
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_regs_verify_original key=%" PRIu64
+	       " marker=%016" PRIx64 " verify=ok\n", key, blob->marker);
+	close(fd);
+	return 0;
+}
+
+static void usage(const char *argv0)
+{
+	fprintf(stderr,
+		"usage: %s prepare|prepare-tls|resume-child|resume-child-tls|verify-original <key>\n",
+		argv0);
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+
+	if (argc < 3) {
+		usage(argv[0]);
+		return 2;
+	}
+	key = strtoull(argv[2], NULL, 0);
+
+	if (!strcmp(argv[1], "prepare"))
+		return do_prepare(key, 0);
+	if (!strcmp(argv[1], "prepare-tls"))
+		return do_prepare(key, 1);
+	if (!strcmp(argv[1], "resume-child"))
+		return do_resume_child(key, 0);
+	if (!strcmp(argv[1], "resume-child-tls"))
+		return do_resume_child(key, 1);
+	if (!strcmp(argv[1], "verify-original"))
+		return do_verify_original(key);
+
+	usage(argv[0]);
+	return 2;
+}
