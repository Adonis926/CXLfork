diff --git a/samples/cxlfork/cxlfork_demo.c b/samples/cxlfork/cxlfork_demo.c
new file mode 100644
index 000000000..08c48dac4
--- /dev/null
+++ b/samples/cxlfork/cxlfork_demo.c
@@ -0,0 +1,200 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define DATA_BASE ((void *)0x76a000000000ULL)
+#define DEFAULT_LEN (2UL * 1024UL * 1024UL)
+
+static uint64_t pattern(uint64_t index)
+{
+	return 0xc001f00d00000000ULL ^ (index * 0x9e3779b97f4a7c15ULL);
+}
+
+static void usage(const char *argv0)
+{
+	fprintf(stderr,
+		"usage: %s checkpoint|restore|stats|release <key> [bytes]\n",
+		argv0);
+}
+
+static size_t parse_len(int argc, char **argv)
+{
+	size_t len = DEFAULT_LEN;
+
+	if (argc >= 4)
+		len = strtoull(argv[3], NULL, 0);
+	len = (len + 4095UL) & ~4095UL;
+	return len;
+}
+
+static int fill_region(size_t len)
+{
+	uint64_t *data;
+	size_t words = len / sizeof(*data);
+	size_t i;
+
+	data = mmap(DATA_BASE, len, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (data == MAP_FAILED) {
+		perror("mmap");
+		return -1;
+	}
+
+	for (i = 0; i < words; i++)
+		data[i] = pattern(i);
+	return 0;
+}
+
+static int verify_region(size_t len)
+{
+	volatile uint64_t *data = DATA_BASE;
+	size_t words = len / sizeof(*data);
+	size_t step = 4096 / sizeof(*data);
+	size_t i;
+
+	for (i = 0; i < words; i += step) {
+		uint64_t got = data[i];
+		uint64_t want = pattern(i);
+
+		if (got != want) {
+			fprintf(stderr,
+				"verify failed at word=%zu got=%016" PRIx64
+				" want=%016" PRIx64 "\n",
+				i, got, want);
+			return -1;
+		}
+	}
+
+	if (words) {
+		uint64_t got = data[words - 1];
+		uint64_t want = pattern(words - 1);
+
+		if (got != want) {
+			fprintf(stderr,
+				"verify failed at last got=%016" PRIx64
+				" want=%016" PRIx64 "\n",
+				got, want);
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int do_checkpoint(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+
+	if (fill_region(len))
+		return 1;
+	if (verify_region(len))
+		return 1;
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)DATA_BASE;
+	op.scan_end = (uintptr_t)DATA_BASE + len;
+
+	if (ioctl(fd, CXLFORK_CHECKPOINT, &op)) {
+		perror("CXLFORK_CHECKPOINT");
+		return 1;
+	}
+	printf("cxlfork_checkpoint key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " checkpoint_ns=%" PRIu64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.checkpoint_ns);
+	return 0;
+}
+
+static int do_restore(int fd, uint64_t key, size_t len)
+{
+	struct cxlfork_restore op;
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		return 1;
+	}
+	if (verify_region(len))
+		return 1;
+
+	printf("cxlfork_restore key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " restore_ns=%" PRIu64 " verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.restore_ns);
+	return 0;
+}
+
+static int do_stats(int fd, uint64_t key)
+{
+	struct cxlfork_stats st;
+
+	memset(&st, 0, sizeof(st));
+	st.key = key;
+	if (ioctl(fd, CXLFORK_STATS, &st)) {
+		perror("CXLFORK_STATS");
+		return 1;
+	}
+	printf("cxlfork_stats key=%" PRIu64 " ready=%" PRIu64
+	       " slot=%" PRIu64 " regions=%" PRIu64
+	       " pages=%" PRIu64 " faults=%" PRIu64 "\n",
+	       key, st.ready, st.slot, st.nr_regions, st.total_pages,
+	       st.faults);
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+	size_t len;
+	int fd;
+	int ret;
+
+	if (argc < 3) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	key = strtoull(argv[2], NULL, 0);
+	len = parse_len(argc, argv);
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	if (!strcmp(argv[1], "checkpoint"))
+		ret = do_checkpoint(fd, key, len);
+	else if (!strcmp(argv[1], "restore"))
+		ret = do_restore(fd, key, len);
+	else if (!strcmp(argv[1], "stats"))
+		ret = do_stats(fd, key);
+	else if (!strcmp(argv[1], "release")) {
+		struct cxlfork_release rel = { .key = key };
+
+		ret = ioctl(fd, CXLFORK_RELEASE, &rel) ? 1 : 0;
+		if (ret)
+			perror("CXLFORK_RELEASE");
+	} else {
+		usage(argv[0]);
+		ret = 2;
+	}
+
+	close(fd);
+	return ret;
+}
