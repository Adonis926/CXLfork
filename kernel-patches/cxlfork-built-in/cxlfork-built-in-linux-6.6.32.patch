diff --git a/samples/cxlfork/cxlfork_workload_bench.c b/samples/cxlfork/cxlfork_workload_bench.c
new file mode 100644
index 000000000..8a89ae69b
--- /dev/null
+++ b/samples/cxlfork/cxlfork_workload_bench.c
@@ -0,0 +1,343 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define WORKLOAD_BASE ((void *)0x776000000000ULL)
+#define PAGE_SIZE_LOCAL 4096UL
+
+enum workload_kind {
+	WORKLOAD_TOUCH,
+	WORKLOAD_FLOAT,
+	WORKLOAD_JSON,
+	WORKLOAD_PYAES,
+	WORKLOAD_HTML,
+};
+
+static uint64_t nsec_now(void)
+{
+	struct timespec ts;
+
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000000000ULL + ts.tv_nsec;
+}
+
+static size_t round_len(size_t len)
+{
+	return (len + PAGE_SIZE_LOCAL - 1) & ~(PAGE_SIZE_LOCAL - 1);
+}
+
+static enum workload_kind parse_workload(const char *name)
+{
+	if (!strcmp(name, "touch"))
+		return WORKLOAD_TOUCH;
+	if (!strcmp(name, "float") || !strcmp(name, "Float"))
+		return WORKLOAD_FLOAT;
+	if (!strcmp(name, "json") || !strcmp(name, "Json"))
+		return WORKLOAD_JSON;
+	if (!strcmp(name, "pyaes") || !strcmp(name, "Pyaes"))
+		return WORKLOAD_PYAES;
+	if (!strcmp(name, "html") || !strcmp(name, "HTML"))
+		return WORKLOAD_HTML;
+	fprintf(stderr, "unknown workload: %s\n", name);
+	exit(2);
+}
+
+static const char *workload_name(enum workload_kind kind)
+{
+	switch (kind) {
+	case WORKLOAD_TOUCH:
+		return "touch";
+	case WORKLOAD_FLOAT:
+		return "Float";
+	case WORKLOAD_JSON:
+		return "Json";
+	case WORKLOAD_PYAES:
+		return "Pyaes";
+	case WORKLOAD_HTML:
+		return "HTML";
+	}
+	return "unknown";
+}
+
+static uint8_t byte_pattern(size_t i, enum workload_kind kind)
+{
+	static const char json_chars[] =
+		"{\"key\":12345,\"value\":\"abcdef\",\"items\":[1,2,3,4]},";
+	static const char html_chars[] =
+		"<div class=\"item\"><span>cxlfork benchmark</span></div>\n";
+
+	if (kind == WORKLOAD_JSON)
+		return json_chars[i % (sizeof(json_chars) - 1)];
+	if (kind == WORKLOAD_HTML)
+		return html_chars[i % (sizeof(html_chars) - 1)];
+	return (uint8_t)((i * 1315423911ULL + (uint64_t)kind * 17ULL) >> 8);
+}
+
+static int map_and_fill(size_t len, enum workload_kind kind)
+{
+	uint8_t *p;
+	size_t i;
+
+	p = mmap(WORKLOAD_BASE, len, PROT_READ | PROT_WRITE,
+		 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (p == MAP_FAILED) {
+		perror("mmap workload");
+		return -1;
+	}
+	for (i = 0; i < len; i++)
+		p[i] = byte_pattern(i, kind);
+	return 0;
+}
+
+static uint64_t run_touch(size_t len)
+{
+	volatile uint8_t *p = WORKLOAD_BASE;
+	uint64_t sum = 0;
+	size_t i;
+
+	for (i = 0; i < len; i += PAGE_SIZE_LOCAL)
+		sum += p[i];
+	return sum;
+}
+
+static uint64_t run_float(size_t len)
+{
+	volatile uint8_t *p = WORKLOAD_BASE;
+	size_t count = len / sizeof(double);
+	double acc = 1.000001;
+	size_t i;
+
+	for (i = 0; i < count; i++) {
+		double v = (double)(p[(i * sizeof(double)) % len] + 1) * 0.0009765625;
+
+		acc = acc * 1.0000001 + v;
+		if (acc > 4096.0)
+			acc *= 0.25;
+	}
+	return (uint64_t)(acc * 1000000.0);
+}
+
+static uint64_t run_json(size_t len)
+{
+	volatile uint8_t *p = WORKLOAD_BASE;
+	uint64_t score = 0;
+	int depth = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		uint8_t c = p[i];
+
+		if (c == '{' || c == '[')
+			depth++;
+		else if ((c == '}' || c == ']') && depth > 0)
+			depth--;
+		else if (c >= '0' && c <= '9')
+			score += (uint64_t)(c - '0') * (uint64_t)(depth + 1);
+		else if (c == '"')
+			score ^= i;
+	}
+	return score ^ (uint64_t)depth;
+}
+
+static uint64_t run_pyaes(size_t len)
+{
+	volatile uint8_t *p = WORKLOAD_BASE;
+	uint32_t s0 = 0x00112233U;
+	uint32_t s1 = 0x44556677U;
+	uint32_t s2 = 0x8899aabbU;
+	uint32_t s3 = 0xccddeeffU;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		uint32_t b = p[i];
+
+		s0 = ((s0 << 5) | (s0 >> 27)) ^ (b + s3);
+		s1 = ((s1 << 7) | (s1 >> 25)) + (s0 ^ (b * 0x45d9f3bU));
+		s2 = ((s2 << 11) | (s2 >> 21)) ^ (s1 + 0x9e3779b9U);
+		s3 = ((s3 << 13) | (s3 >> 19)) + (s2 ^ b);
+	}
+	return ((uint64_t)s0 << 32) ^ s1 ^ s2 ^ s3;
+}
+
+static uint64_t run_html(size_t len)
+{
+	volatile uint8_t *p = WORKLOAD_BASE;
+	uint64_t tags = 0;
+	uint64_t text = 0;
+	int in_tag = 0;
+	size_t i;
+
+	for (i = 0; i < len; i++) {
+		uint8_t c = p[i];
+
+		if (c == '<') {
+			in_tag = 1;
+			tags++;
+		} else if (c == '>') {
+			in_tag = 0;
+		} else if (!in_tag && c > ' ') {
+			text += c;
+		}
+	}
+	return (tags << 32) ^ text;
+}
+
+static uint64_t run_workload(size_t len, enum workload_kind kind)
+{
+	switch (kind) {
+	case WORKLOAD_TOUCH:
+		return run_touch(len);
+	case WORKLOAD_FLOAT:
+		return run_float(len);
+	case WORKLOAD_JSON:
+		return run_json(len);
+	case WORKLOAD_PYAES:
+		return run_pyaes(len);
+	case WORKLOAD_HTML:
+		return run_html(len);
+	}
+	return 0;
+}
+
+static int do_prepare(uint64_t key, size_t len, enum workload_kind kind)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	uint64_t checksum;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+	if (map_and_fill(len, kind)) {
+		close(fd);
+		return 1;
+	}
+	checksum = run_workload(len, WORKLOAD_TOUCH);
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)WORKLOAD_BASE;
+	op.scan_end = (uintptr_t)WORKLOAD_BASE + len;
+	if (ioctl(fd, CXLFORK_FORK_PREPARE, &op)) {
+		perror("CXLFORK_FORK_PREPARE");
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_workload_prepare key=%" PRIu64 " workload=%s"
+	       " bytes=%zu regions=%" PRIu64 " pages=%" PRIu64
+	       " prepare_ns=%" PRIu64 " checksum=%" PRIu64 " verify=ok\n",
+	       key, workload_name(kind), len, op.nr_regions, op.total_pages,
+	       op.checkpoint_ns, checksum);
+	close(fd);
+	return 0;
+}
+
+static int child_resume_run(uint64_t key, size_t len, enum workload_kind kind)
+{
+	struct cxlfork_restore op;
+	uint64_t workload_begin;
+	uint64_t workload_ns;
+	uint64_t checksum;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW | CXLFORK_F_APPLY_MM_STATE |
+		   CXLFORK_F_APPLY_GLOBAL_STATE | CXLFORK_F_REOPEN_FDS;
+	if (ioctl(fd, CXLFORK_FORK_RESUME, &op)) {
+		perror("CXLFORK_FORK_RESUME");
+		close(fd);
+		return 1;
+	}
+	workload_begin = nsec_now();
+	checksum = run_workload(len, kind);
+	workload_ns = nsec_now() - workload_begin;
+
+	printf("cxlfork_workload_child key=%" PRIu64 " workload=%s"
+	       " child_pid=%ld regions=%" PRIu64 " pages=%" PRIu64
+	       " restore_ns=%" PRIu64 " global_restore_ns=%" PRIu64
+	       " fds_restored=%" PRIu64 " workload_ns=%" PRIu64
+	       " checksum=%" PRIu64 " verify=ok\n",
+	       key, workload_name(kind), (long)getpid(), op.nr_regions,
+	       op.total_pages, op.restore_ns, op.global_restore_ns,
+	       op.nr_fds_restored, workload_ns, checksum);
+	fflush(stdout);
+	close(fd);
+	return 0;
+}
+
+static int do_resume(uint64_t key, size_t len, enum workload_kind kind)
+{
+	uint64_t begin = nsec_now();
+	uint64_t total_ns;
+	pid_t pid;
+	int status;
+
+	pid = fork();
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (!pid)
+		_exit(child_resume_run(key, len, kind));
+	if (waitpid(pid, &status, 0) != pid) {
+		perror("waitpid");
+		return 1;
+	}
+	total_ns = nsec_now() - begin;
+	if (!WIFEXITED(status) || WEXITSTATUS(status))
+		return 1;
+	printf("cxlfork_workload_parent key=%" PRIu64 " workload=%s"
+	       " child_pid=%ld total_ns=%" PRIu64 " status=ok\n",
+	       key, workload_name(kind), (long)pid, total_ns);
+	return 0;
+}
+
+static void usage(const char *prog)
+{
+	fprintf(stderr, "usage: %s prepare|resume <key> <workload> <bytes>\n", prog);
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+	enum workload_kind kind;
+	size_t len;
+
+	if (argc != 5) {
+		usage(argv[0]);
+		return 2;
+	}
+	key = strtoull(argv[2], NULL, 0);
+	kind = parse_workload(argv[3]);
+	len = round_len(strtoull(argv[4], NULL, 0));
+
+	if (!strcmp(argv[1], "prepare"))
+		return do_prepare(key, len, kind);
+	if (!strcmp(argv[1], "resume"))
+		return do_resume(key, len, kind);
+	usage(argv[0]);
+	return 2;
+}
