+static int cxlfork_build_pt_page_image(struct cxlfork_desc *desc, u64 *data_off)
+{
+	struct cxlfork_pt_page_image *meta;
+	u64 meta_bytes;
+	u64 pte_page_bytes;
+	u64 i = 0;
+	u64 nr_pages = 0;
+
+	if (!desc->nr_ptes)
+		return 0;
+	while (i < desc->nr_ptes) {
+		u64 va_base = desc->ptes[i].va & PMD_MASK;
+
+		nr_pages++;
+		do {
+			i++;
+		} while (i < desc->nr_ptes &&
+			 (desc->ptes[i].va & PMD_MASK) == va_base);
+	}
+	if (nr_pages > CXLFORK_MAX_PT_PAGE_IMAGES)
+		return -ENOSPC;
+
+	meta_bytes = PAGE_ALIGN(nr_pages * sizeof(*meta));
+	pte_page_bytes = nr_pages * PAGE_SIZE;
+	if (*data_off + meta_bytes + pte_page_bytes >
+	    slot_offset(desc->slot) + CXLFORK_SLOT_BYTES)
+		return -ENOSPC;
+	meta = cxl_ptr(*data_off);
+	if (!meta)
+		return -ENOSPC;
+	memset(meta, 0, meta_bytes + pte_page_bytes);
+
+	desc->pt_page_image_offset = *data_off;
+	desc->pt_page_image_entries = nr_pages;
+	desc->pt_page_image_pages = (meta_bytes + pte_page_bytes) >> PAGE_SHIFT;
+	*data_off += meta_bytes;
+
+	i = 0;
+	nr_pages = 0;
+	while (i < desc->nr_ptes) {
+		u64 va_base = desc->ptes[i].va & PMD_MASK;
+		u64 pte_index_base = i;
+		u64 page_off = *data_off;
+		u64 *ptes = cxl_ptr(page_off);
+
+		if (!ptes)
+			return -ENOSPC;
+		memset(ptes, 0, PAGE_SIZE);
+		meta[nr_pages].va_base = va_base;
+		meta[nr_pages].pte_index_base = pte_index_base;
+		meta[nr_pages].pte_page_offset = page_off;
+		do {
+			const struct cxlfork_pte_desc *pte = &desc->ptes[i];
+			u64 slot = (pte->va - va_base) >> PAGE_SHIFT;
+
+			ptes[slot] = cxlfork_make_pteval(pte->cxl_offset,
+						       PROT_READ, true);
+			i++;
+			meta[nr_pages].nr_ptes++;
+		} while (i < desc->nr_ptes &&
+			 (desc->ptes[i].va & PMD_MASK) == va_base);
+		*data_off += PAGE_SIZE;
+		nr_pages++;
+	}
+	return 0;
+}
