 	cxlfork_capture_namespace_state(&op->restore_ns_state);
diff --git a/include/uapi/linux/cxlfork.h b/include/uapi/linux/cxlfork.h
index a21410825..68c317086 100644
--- a/include/uapi/linux/cxlfork.h
+++ b/include/uapi/linux/cxlfork.h
@@ -153,6 +153,9 @@ struct cxlfork_checkpoint {
