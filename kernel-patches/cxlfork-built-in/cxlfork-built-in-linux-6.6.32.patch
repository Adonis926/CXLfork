 1 file changed, 41 insertions(+), 1 deletion(-)

diff --git a/drivers/cxlfork/cxlfork_main.c b/drivers/cxlfork/cxlfork_main.c
index 1ecef8eb5..19ac0c50e 100644
--- a/drivers/cxlfork/cxlfork_main.c
+++ b/drivers/cxlfork/cxlfork_main.c
@@ -577,6 +577,39 @@ static vm_fault_t cxlfork_insert_shared_cxl(struct vm_fault *vmf,
 				phys_to_pfn_t(cxl_phys + pte->cxl_offset, 0));
 }
 
+static int cxlfork_prefault_shared_cxl(struct vm_area_struct *vma,
+				       const struct cxlfork_desc *desc,
+				       const struct cxlfork_region_desc *r)
+{
+	const struct cxlfork_pte_desc *first;
+	u64 i;
+
+	if (!r->pages)
+		return 0;
+	first = &desc->ptes[r->pgoff_first];
+	if (first->va != r->start || !cxl_ptr(first->cxl_offset))
+		return -EINVAL;
+	for (i = 1; i < r->pages; i++) {
+		const struct cxlfork_pte_desc *prev = &desc->ptes[r->pgoff_first + i - 1];
+		const struct cxlfork_pte_desc *pte = &desc->ptes[r->pgoff_first + i];
+
+		if (pte->va != r->start + i * PAGE_SIZE ||
+		    pte->cxl_offset != prev->cxl_offset + PAGE_SIZE ||
+		    !cxl_ptr(pte->cxl_offset))
+			return -EINVAL;
+	}
+
+	/*
+	 * Match the CXLfork default restore path: install read-only CXL PTEs
+	 * during restore so loads access the checkpoint directly, while later
+	 * stores take the kernel COW path and copy the target page locally.
+	 */
+	vm_flags_set(vma, VM_IO | VM_PFNMAP | VM_DONTEXPAND | VM_DONTDUMP);
+	return io_remap_pfn_range(vma, r->start,
+				  (cxl_phys + first->cxl_offset) >> PAGE_SHIFT,
+				  r->length, prot_from_uapi(r->prot, true));
+}
+
 static vm_fault_t cxlfork_fault(struct vm_fault *vmf)
 {
 	struct cxlfork_mapping *mapping = vmf->vma->vm_private_data;
@@ -730,7 +763,14 @@ static int cxlfork_mmap(struct file *file, struct vm_area_struct *vma)
 	mapping->flags = state->mmap_flags;
 	refcount_set(&mapping->refs, 1);
 
-	vm_flags_set(vma, VM_DONTEXPAND | VM_DONTDUMP | VM_MIXEDMAP);
+	if (mapping->flags & CXLFORK_F_SHARED_COW)
+		ret = cxlfork_prefault_shared_cxl(vma, desc, r);
+	else
+		vm_flags_set(vma, VM_DONTEXPAND | VM_DONTDUMP | VM_MIXEDMAP);
+	if (ret) {
+		kfree(mapping);
+		goto out_unlock;
+	}
 	vma->vm_ops = &cxlfork_vm_ops;
 	vma->vm_private_data = mapping;
 
-- 
