diff --git a/drivers/cxlfork/Kconfig b/drivers/cxlfork/Kconfig
new file mode 100644
index 000000000..36cc2c473
--- /dev/null
+++ b/drivers/cxlfork/Kconfig
@@ -0,0 +1,11 @@
+# SPDX-License-Identifier: GPL-2.0-only
+config CXLFORK
+	tristate "CXLfork checkpoint/restore prototype"
+	depends on MMU && X86_64
+	help
+	  Build a small CXLfork prototype device. It checkpoints selected
+	  user pages into a shared CXL memory window and lets another VM
+	  restore by mapping those CXL-resident pages.
+
+	  This is an experimental research driver for reproducing CXLfork
+	  mechanisms, not a production checkpoint/restore facility.
