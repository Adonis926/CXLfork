new file mode 100644
index 000000000..a04a9bc2a
--- /dev/null
+++ b/samples/cxlfork/cxlfork_context_demo.c
@@ -0,0 +1,238 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <ucontext.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define CTX_BASE ((void *)0x776000000000ULL)
+#define CTX_LEN (4UL * 1024UL * 1024UL)
+#define CTX_STACK_OFF (1UL * 1024UL * 1024UL)
+#define CTX_STACK_SIZE (1UL * 1024UL * 1024UL)
+#define CTX_MAGIC 0x43584c4653544154ULL
+#define CTX_MARKER 0x5152535455565758ULL
+#define CTX_AFTER 0x8182838485868788ULL
+
+struct cxlfork_context_blob {
+	uint64_t magic;
+	uint64_t key;
+	uint64_t marker;
+	uint64_t resume_pid;
+	ucontext_t ctx;
+};
+
+static struct cxlfork_context_blob *blob_at_base(void)
+{
+	return (struct cxlfork_context_blob *)CTX_BASE;
+}
+
+static void resumed_entry(uintptr_t blob_addr)
+{
+	struct cxlfork_context_blob *blob = (void *)blob_addr;
+
+	if (blob->magic != CTX_MAGIC || blob->marker != CTX_MARKER) {
+		fprintf(stderr, "context resume verify failed magic=%016" PRIx64
+			" marker=%016" PRIx64 "\n", blob->magic, blob->marker);
+		exit(1);
+	}
+
+	blob->resume_pid = getpid();
+	blob->marker = CTX_AFTER;
+	printf("cxlfork_context_resumed key=%" PRIu64
+	       " pid=%ld marker=%016" PRIx64 " stack=%p verify=ok\n",
+	       blob->key, (long)getpid(), blob->marker, &blob_addr);
+	fflush(stdout);
+	exit(0);
+}
+
+static int map_context_region(void)
+{
+	void *addr;
+
+	addr = mmap(CTX_BASE, CTX_LEN, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (addr == MAP_FAILED) {
+		perror("mmap context");
+		return -1;
+	}
+	return 0;
+}
+
+static int do_prepare(uint64_t key)
+{
+	struct cxlfork_context_blob *blob;
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+	if (map_context_region()) {
+		close(fd);
+		return 1;
+	}
+
+	blob = blob_at_base();
+	memset(blob, 0, sizeof(*blob));
+	blob->magic = CTX_MAGIC;
+	blob->key = key;
+	blob->marker = CTX_MARKER;
+
+	if (getcontext(&blob->ctx)) {
+		perror("getcontext");
+		close(fd);
+		return 1;
+	}
+	blob->ctx.uc_stack.ss_sp = (char *)CTX_BASE + CTX_STACK_OFF;
+	blob->ctx.uc_stack.ss_size = CTX_STACK_SIZE;
+	blob->ctx.uc_link = NULL;
+	makecontext(&blob->ctx, (void (*)(void))resumed_entry, 1,
+		    (uintptr_t)blob);
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)CTX_BASE;
+	op.scan_end = (uintptr_t)CTX_BASE + CTX_LEN;
+	if (ioctl(fd, CXLFORK_FORK_PREPARE, &op)) {
+		perror("CXLFORK_FORK_PREPARE");
+		close(fd);
+		return 1;
+	}
+
+	printf("cxlfork_context_prepare key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " prepare_ns=%" PRIu64 " entry=%p stack=%p verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.checkpoint_ns,
+	       resumed_entry, blob->ctx.uc_stack.ss_sp);
+	close(fd);
+	return 0;
+}
+
+static int child_resume_context(uint64_t key)
+{
+	struct cxlfork_context_blob *blob = blob_at_base();
+	struct cxlfork_restore op;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW;
+	if (ioctl(fd, CXLFORK_FORK_RESUME, &op)) {
+		perror("CXLFORK_FORK_RESUME");
+		close(fd);
+		return 1;
+	}
+	close(fd);
+
+	printf("cxlfork_context_resume_apply key=%" PRIu64
+	       " child_pid=%ld regions=%" PRIu64 " pages=%" PRIu64
+	       " resume_ns=%" PRIu64 "\n",
+	       key, (long)getpid(), op.nr_regions, op.total_pages, op.restore_ns);
+	fflush(stdout);
+	setcontext(&blob->ctx);
+	perror("setcontext");
+	return 1;
+}
+
+static int do_resume_child(uint64_t key)
+{
+	pid_t pid;
+	int status;
+
+	pid = fork();
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (pid == 0)
+		exit(child_resume_context(key));
+
+	if (waitpid(pid, &status, 0) != pid) {
+		perror("waitpid");
+		return 1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status))
+		return 1;
+	printf("cxlfork_context_parent key=%" PRIu64
+	       " child_pid=%ld status=ok\n", key, (long)pid);
+	return 0;
+}
+
+static int do_verify_original(uint64_t key)
+{
+	struct cxlfork_context_blob *blob = blob_at_base();
+	struct cxlfork_restore op;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		close(fd);
+		return 1;
+	}
+	if (blob->marker != CTX_MARKER) {
+		fprintf(stderr, "context checkpoint changed marker=%016" PRIx64
+			" want=%016" PRIx64 "\n", blob->marker, (uint64_t)CTX_MARKER);
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_context_verify_original key=%" PRIu64
+	       " marker=%016" PRIx64 " verify=ok\n", key, blob->marker);
+	close(fd);
+	return 0;
+}
+
+static void usage(const char *argv0)
+{
+	fprintf(stderr, "usage: %s prepare|resume-child|verify-original <key>\n",
+		argv0);
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+
+	if (argc < 3) {
+		usage(argv[0]);
+		return 2;
+	}
+	key = strtoull(argv[2], NULL, 0);
+
+	if (!strcmp(argv[1], "prepare"))
+		return do_prepare(key);
+	if (!strcmp(argv[1], "resume-child"))
+		return do_resume_child(key);
+	if (!strcmp(argv[1], "verify-original"))
+		return do_verify_original(key);
+
+	usage(argv[0]);
+	return 2;
+}
