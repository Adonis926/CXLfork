new file mode 100644
index 000000000..6945a831e
--- /dev/null
+++ b/samples/cxlfork/cxlfork_regs_demo.c
@@ -0,0 +1,221 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define REGS_BASE ((void *)0x777000000000ULL)
+#define REGS_LEN (2UL * 1024UL * 1024UL)
+#define REGS_STACK_OFF (1UL * 1024UL * 1024UL)
+#define REGS_STACK_SIZE (512UL * 1024UL)
+#define REGS_MAGIC 0x43584c4652454753ULL
+#define REGS_DONE 0x444f4e4552454753ULL
+
+struct regs_blob {
+	uint64_t magic;
+	uint64_t key;
+	uint64_t marker;
+	uint64_t pid;
+};
+
+static struct regs_blob *blob_at_base(void)
+{
+	return (struct regs_blob *)REGS_BASE;
+}
+
+__attribute__((noreturn)) static void regs_resume_entry(uintptr_t blob_addr)
+{
+	struct regs_blob *blob = (void *)blob_addr;
+
+	if (blob->magic != REGS_MAGIC || blob->key == 0) {
+		_exit(101);
+	}
+	blob->pid = getpid();
+	blob->marker = REGS_DONE;
+	printf("cxlfork_regs_resumed key=%" PRIu64 " pid=%ld marker=%016" PRIx64
+	       " stack=%p verify=ok\n",
+	       blob->key, (long)getpid(), blob->marker, &blob_addr);
+	fflush(stdout);
+	_exit(0);
+}
+
+static int map_regs_region(void)
+{
+	void *addr;
+
+	addr = mmap(REGS_BASE, REGS_LEN, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (addr == MAP_FAILED) {
+		perror("mmap regs");
+		return -1;
+	}
+	return 0;
+}
+
+static int do_prepare(uint64_t key)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	struct regs_blob *blob;
+	uintptr_t stack_top;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+	if (map_regs_region()) {
+		close(fd);
+		return 1;
+	}
+
+	blob = blob_at_base();
+	memset(blob, 0, sizeof(*blob));
+	blob->magic = REGS_MAGIC;
+	blob->key = key;
+	stack_top = (uintptr_t)REGS_BASE + REGS_STACK_OFF + REGS_STACK_SIZE - 16;
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)REGS_BASE;
+	op.scan_end = (uintptr_t)REGS_BASE + REGS_LEN;
+	op.flags = CXLFORK_F_USER_THREAD_STATE;
+	op.thread_state.ip = (uintptr_t)regs_resume_entry;
+	op.thread_state.sp = stack_top;
+	op.thread_state.di = (uintptr_t)REGS_BASE;
+
+	if (ioctl(fd, CXLFORK_FORK_PREPARE, &op)) {
+		perror("CXLFORK_FORK_PREPARE");
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_regs_prepare key=%" PRIu64 " entry=%016" PRIx64
+	       " sp=%016" PRIx64 " arg=%016" PRIx64
+	       " pages=%" PRIu64 " prepare_ns=%" PRIu64 " verify=ok\n",
+	       key, op.thread_state.ip, op.thread_state.sp, op.thread_state.di,
+	       op.total_pages, op.checkpoint_ns);
+	close(fd);
+	return 0;
+}
+
+static int child_resume_regs(uint64_t key)
+{
+	struct cxlfork_restore op;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW | CXLFORK_F_APPLY_THREAD_STATE;
+	if (ioctl(fd, CXLFORK_FORK_RESUME, &op)) {
+		perror("CXLFORK_FORK_RESUME");
+		close(fd);
+		return 1;
+	}
+
+	/*
+	 * On success the syscall return path should use the restored pt_regs
+	 * and never execute this user instruction stream again.
+	 */
+	fprintf(stderr, "unexpected return after APPLY_THREAD_STATE\n");
+	close(fd);
+	return 1;
+}
+
+static int do_resume_child(uint64_t key)
+{
+	pid_t pid;
+	int status;
+
+	pid = fork();
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (pid == 0)
+		_exit(child_resume_regs(key));
+
+	if (waitpid(pid, &status, 0) != pid) {
+		perror("waitpid");
+		return 1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status))
+		return 1;
+	printf("cxlfork_regs_parent key=%" PRIu64 " child_pid=%ld status=ok\n",
+	       key, (long)pid);
+	return 0;
+}
+
+static int do_verify_original(uint64_t key)
+{
+	struct cxlfork_restore op;
+	struct regs_blob *blob = blob_at_base();
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		close(fd);
+		return 1;
+	}
+	if (blob->marker != 0) {
+		fprintf(stderr, "regs checkpoint changed marker=%016" PRIx64 "\n",
+			blob->marker);
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_regs_verify_original key=%" PRIu64
+	       " marker=%016" PRIx64 " verify=ok\n", key, blob->marker);
+	close(fd);
+	return 0;
+}
+
+static void usage(const char *argv0)
+{
+	fprintf(stderr, "usage: %s prepare|resume-child|verify-original <key>\n",
+		argv0);
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+
+	if (argc < 3) {
+		usage(argv[0]);
+		return 2;
+	}
+	key = strtoull(argv[2], NULL, 0);
+
+	if (!strcmp(argv[1], "prepare"))
