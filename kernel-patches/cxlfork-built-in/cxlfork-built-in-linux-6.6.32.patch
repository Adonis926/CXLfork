new file mode 100644
index 000000000..94ccd79be
--- /dev/null
+++ b/samples/cxlfork/cxlfork_global_demo.c
@@ -0,0 +1,202 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _POSIX_C_SOURCE 200809L
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <signal.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/resource.h>
+#include <sys/stat.h>
+#include <sys/time.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define GLOBAL_BASE ((void *)0x777000000000ULL)
+#define GLOBAL_LEN 4096UL
+#define GLOBAL_FD 77
+
+static void die(const char *msg)
+{
+	perror(msg);
+	exit(1);
+}
+
+static uint64_t nsec_now(void)
+{
+	struct timeval tv;
+
+	gettimeofday(&tv, NULL);
+	return (uint64_t)tv.tv_sec * 1000000000ULL + (uint64_t)tv.tv_usec * 1000ULL;
+}
+
+static void map_payload(void)
+{
+	uint64_t *p;
+
+	p = mmap(GLOBAL_BASE, GLOBAL_LEN, PROT_READ | PROT_WRITE,
+		 MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (p == MAP_FAILED)
+		die("mmap");
+	*p = 0xc6840b1a15ULL;
+}
+
+static int prepare(uint64_t key, const char *dir, const char *file)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	struct rlimit rl = { .rlim_cur = 777, .rlim_max = 777 };
+	stack_t ss;
+	sigset_t mask;
+	char *stack;
+	int fd;
+	int devfd;
+
+	if (chdir(dir))
+		die("chdir prepare");
+	umask(0027);
+	if (setrlimit(RLIMIT_NOFILE, &rl))
+		die("setrlimit prepare");
+	sigemptyset(&mask);
+	sigaddset(&mask, SIGUSR1);
+	if (sigprocmask(SIG_SETMASK, &mask, NULL))
+		die("sigprocmask prepare");
+	stack = mmap(NULL, SIGSTKSZ, PROT_READ | PROT_WRITE,
+		     MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
+	if (stack == MAP_FAILED)
+		die("mmap sigaltstack");
+	memset(&ss, 0, sizeof(ss));
+	ss.ss_sp = stack;
+	ss.ss_size = SIGSTKSZ;
+	if (sigaltstack(&ss, NULL))
+		die("sigaltstack prepare");
+	fd = open(file, O_RDWR | O_CREAT, 0644);
+	if (fd < 0)
+		die("open prepare");
+	if (dup2(fd, GLOBAL_FD) != GLOBAL_FD)
+		die("dup2 prepare");
+	if (fd != GLOBAL_FD)
+		close(fd);
+	if (write(GLOBAL_FD, "global-state\n", 13) != 13)
+		die("write prepare");
+	if (lseek(GLOBAL_FD, 0, SEEK_SET) < 0)
+		die("lseek prepare");
+
+	map_payload();
+	devfd = open(CXLFORK_DEVICE, O_RDWR);
+	if (devfd < 0)
+		die(CXLFORK_DEVICE);
+	(void)ioctl(devfd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)GLOBAL_BASE;
+	op.scan_end = (uintptr_t)GLOBAL_BASE + GLOBAL_LEN;
+	if (ioctl(devfd, CXLFORK_FORK_PREPARE, &op))
+		die("CXLFORK_FORK_PREPARE");
+	printf("cxlfork_global_prepare key=%" PRIu64
+	       " checkpoint_ns=%" PRIu64 " global_checkpoint_ns=%" PRIu64
+	       " cwd=%s umask=%03o fd=%d verify=ok\n",
+	       key, op.checkpoint_ns, op.global_checkpoint_ns,
+	       op.global_state.cwd, op.global_state.umask, GLOBAL_FD);
+	close(devfd);
+	return 0;
+}
+
+static int resume(uint64_t key, const char *dir)
+{
+	struct cxlfork_restore op;
+	struct rlimit rl;
+	stack_t ss;
+	sigset_t mask;
+	char cwd[CXLFORK_PATH_LEN];
+	uint64_t begin;
+	int devfd;
+	mode_t old_umask;
+
+	if (chdir("/"))
+		die("chdir reset");
+	umask(0077);
+	rl.rlim_cur = 64;
+	rl.rlim_max = 64;
+	(void)setrlimit(RLIMIT_NOFILE, &rl);
+	sigemptyset(&mask);
+	(void)sigprocmask(SIG_SETMASK, &mask, NULL);
+	memset(&ss, 0, sizeof(ss));
+	ss.ss_flags = SS_DISABLE;
+	(void)sigaltstack(&ss, NULL);
+
+	devfd = open(CXLFORK_DEVICE, O_RDWR);
+	if (devfd < 0)
+		die(CXLFORK_DEVICE);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW | CXLFORK_F_APPLY_MM_STATE |
+		   CXLFORK_F_APPLY_GLOBAL_STATE | CXLFORK_F_REOPEN_FDS;
+	begin = nsec_now();
+	if (ioctl(devfd, CXLFORK_FORK_RESUME, &op))
+		die("CXLFORK_FORK_RESUME");
+	if (!op.restore_ns)
+		op.restore_ns = nsec_now() - begin;
+	if (!getcwd(cwd, sizeof(cwd)))
+		die("getcwd");
+	if (strcmp(cwd, dir)) {
+		fprintf(stderr, "cwd mismatch got=%s want=%s\n", cwd, dir);
+		return 1;
+	}
+	old_umask = umask(0022);
+	(void)umask(old_umask);
+	if (old_umask != 0027) {
+		fprintf(stderr, "umask mismatch got=%03o\n", old_umask);
+		return 1;
+	}
+	if (getrlimit(RLIMIT_NOFILE, &rl) || rl.rlim_cur != 777) {
+		fprintf(stderr, "rlimit mismatch cur=%llu\n",
+			(unsigned long long)rl.rlim_cur);
+		return 1;
+	}
+	if (sigprocmask(SIG_SETMASK, NULL, &mask) || !sigismember(&mask, SIGUSR1)) {
+		fprintf(stderr, "sigmask mismatch\n");
+		return 1;
+	}
+	if (sigaltstack(NULL, &ss) || ss.ss_size != SIGSTKSZ || (ss.ss_flags & SS_DISABLE)) {
+		fprintf(stderr, "sigaltstack mismatch size=%zu flags=0x%x\n",
+			ss.ss_size, ss.ss_flags);
+		return 1;
+	}
+	if (op.nr_fds_restored < 1) {
+		fprintf(stderr, "fd restore count mismatch got=%" PRIu64 "\n",
+			op.nr_fds_restored);
+		return 1;
+	}
+	printf("cxlfork_global_resume key=%" PRIu64
+	       " restore_ns=%" PRIu64 " global_restore_ns=%" PRIu64
+	       " fds_restored=%" PRIu64 " cwd=%s umask=%03o"
+	       " rlimit=%llu sigmask=ok altstack=ok fd_state=ok verify=ok\n",
+	       key, op.restore_ns, op.global_restore_ns, op.nr_fds_restored,
+	       cwd, old_umask, (unsigned long long)rl.rlim_cur);
+	close(devfd);
+	return 0;
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+
+	if (argc != 5) {
+		fprintf(stderr, "usage: %s prepare|resume <key> <dir> <file>\n", argv[0]);
+		return 2;
+	}
+	key = strtoull(argv[2], NULL, 0);
+	if (!strcmp(argv[1], "prepare"))
+		return prepare(key, argv[3], argv[4]);
+	if (!strcmp(argv[1], "resume"))
+		return resume(key, argv[3]);
+	fprintf(stderr, "bad command: %s\n", argv[1]);
+	return 2;
+}
