diff --git a/samples/cxlfork/cxlfork_fork_demo.c b/samples/cxlfork/cxlfork_fork_demo.c
new file mode 100644
index 000000000..2230ed4c4
--- /dev/null
+++ b/samples/cxlfork/cxlfork_fork_demo.c
@@ -0,0 +1,236 @@
+// SPDX-License-Identifier: GPL-2.0
+#define _GNU_SOURCE
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/ioctl.h>
+#include <sys/mman.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include "cxlfork_uapi.h"
+
+#define FORK_BASE ((void *)0x775000000000ULL)
+#define FORK_LEN_DEFAULT (2UL * 1024UL * 1024UL)
+
+static uint64_t fork_pattern(uint64_t index)
+{
+	return 0xf047000000000000ULL ^ (index * 0x9e3779b97f4a7c15ULL);
+}
+
+static size_t parse_len(int argc, char **argv)
+{
+	size_t len = FORK_LEN_DEFAULT;
+
+	if (argc >= 4)
+		len = strtoull(argv[3], NULL, 0);
+	return (len + 4095UL) & ~4095UL;
+}
+
+static int fill_working_set(size_t len)
+{
+	uint64_t *data;
+	size_t words = len / sizeof(*data);
+	size_t i;
+
+	data = mmap(FORK_BASE, len, PROT_READ | PROT_WRITE,
+		    MAP_PRIVATE | MAP_ANONYMOUS | MAP_FIXED_NOREPLACE, -1, 0);
+	if (data == MAP_FAILED) {
+		perror("mmap");
+		return -1;
+	}
+
+	for (i = 0; i < words; i++)
+		data[i] = fork_pattern(i);
+	return 0;
+}
+
+static int verify_working_set(size_t len)
+{
+	volatile uint64_t *data = FORK_BASE;
+	size_t words = len / sizeof(*data);
+	size_t step = 4096 / sizeof(*data);
+	size_t i;
+
+	for (i = 0; i < words; i += step) {
+		uint64_t got = data[i];
+		uint64_t want = fork_pattern(i);
+
+		if (got != want) {
+			fprintf(stderr, "verify failed word=%zu got=%016" PRIx64
+				" want=%016" PRIx64 "\n", i, got, want);
+			return -1;
+		}
+	}
+	return 0;
+}
+
+static int do_prepare(uint64_t key, size_t len)
+{
+	struct cxlfork_checkpoint op;
+	struct cxlfork_release rel = { .key = key };
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	if (fill_working_set(len) || verify_working_set(len)) {
+		close(fd);
+		return 1;
+	}
+
+	(void)ioctl(fd, CXLFORK_RELEASE, &rel);
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.scan_start = (uintptr_t)FORK_BASE;
+	op.scan_end = (uintptr_t)FORK_BASE + len;
+	if (ioctl(fd, CXLFORK_FORK_PREPARE, &op)) {
+		perror("CXLFORK_FORK_PREPARE");
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_fork_prepare key=%" PRIu64
+	       " regions=%" PRIu64 " pages=%" PRIu64
+	       " prepare_ns=%" PRIu64 " pid=%ld verify=ok\n",
+	       key, op.nr_regions, op.total_pages, op.checkpoint_ns, (long)getpid());
+	close(fd);
+	return 0;
+}
+
+static int child_resume_and_run(uint64_t key, size_t len)
+{
+	struct cxlfork_restore op;
+	volatile uint64_t *data = FORK_BASE;
+	uint64_t before;
+	uint64_t after = 0xabcddcba12344321ULL;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_SHARED_COW;
+	if (ioctl(fd, CXLFORK_FORK_RESUME, &op)) {
+		perror("CXLFORK_FORK_RESUME");
+		close(fd);
+		return 1;
+	}
+
+	if (verify_working_set(len)) {
+		close(fd);
+		return 1;
+	}
+	before = data[0];
+	data[0] = after;
+	if (data[0] != after) {
+		fprintf(stderr, "child write failed\n");
+		close(fd);
+		return 1;
+	}
+
+	printf("cxlfork_fork_resume_child key=%" PRIu64
+	       " child_pid=%ld regions=%" PRIu64 " pages=%" PRIu64
+	       " resume_ns=%" PRIu64 " before=%016" PRIx64
+	       " after=%016" PRIx64 " verify=ok\n",
+	       key, (long)getpid(), op.nr_regions, op.total_pages,
+	       op.restore_ns, before, data[0]);
+	close(fd);
+	return 0;
+}
+
+static int do_resume_child(uint64_t key, size_t len)
+{
+	pid_t pid;
+	int status;
+
+	pid = fork();
+	if (pid < 0) {
+		perror("fork");
+		return 1;
+	}
+	if (pid == 0)
+		exit(child_resume_and_run(key, len));
+
+	if (waitpid(pid, &status, 0) != pid) {
+		perror("waitpid");
+		return 1;
+	}
+	if (!WIFEXITED(status) || WEXITSTATUS(status))
+		return 1;
+	printf("cxlfork_fork_resume_parent key=%" PRIu64
+	       " child_pid=%ld status=ok\n", key, (long)pid);
+	return 0;
+}
+
+static int do_verify_original(uint64_t key)
+{
+	struct cxlfork_restore op;
+	volatile uint64_t *data = FORK_BASE;
+	int fd;
+
+	fd = open(CXLFORK_DEVICE, O_RDWR);
+	if (fd < 0) {
+		perror(CXLFORK_DEVICE);
+		return 1;
+	}
+
+	memset(&op, 0, sizeof(op));
+	op.key = key;
+	op.flags = CXLFORK_F_MAP_READONLY;
+	if (ioctl(fd, CXLFORK_RESTORE, &op)) {
+		perror("CXLFORK_RESTORE");
+		close(fd);
+		return 1;
+	}
+	if (data[0] != fork_pattern(0)) {
+		fprintf(stderr, "checkpoint changed got=%016" PRIx64
+			" want=%016" PRIx64 "\n", data[0], fork_pattern(0));
+		close(fd);
+		return 1;
+	}
+	printf("cxlfork_fork_verify_original key=%" PRIu64
+	       " first=%016" PRIx64 " verify=ok\n", key, data[0]);
+	close(fd);
+	return 0;
+}
+
+static void usage(const char *argv0)
+{
+	fprintf(stderr, "usage: %s prepare|resume-child|verify-original <key> [bytes]\n",
+		argv0);
+}
+
+int main(int argc, char **argv)
+{
+	uint64_t key;
+	size_t len;
+
+	if (argc < 3) {
+		usage(argv[0]);
+		return 2;
+	}
+
+	key = strtoull(argv[2], NULL, 0);
+	len = parse_len(argc, argv);
+
+	if (!strcmp(argv[1], "prepare"))
+		return do_prepare(key, len);
+	if (!strcmp(argv[1], "resume-child"))
+		return do_resume_child(key, len);
+	if (!strcmp(argv[1], "verify-original"))
+		return do_verify_original(key);
+
+	usage(argv[0]);
+	return 2;
+}
