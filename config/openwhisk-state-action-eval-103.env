# OpenWhisk state-action evaluation profile for Lux (10.0.16.103).
# Sourcing this file has no side effects.  The authoritative runner performs
# all safety checks before it starts a VM or writes the reserved DAX extent.

export OWE_HOST=${OWE_HOST:-Lux}
export OWE_ROOT=${OWE_ROOT:-/home/xtl/start/hpca-openwhisk-eval}
export OWE_RESULT_ROOT=${OWE_RESULT_ROOT:-$OWE_ROOT/results}
export OWE_ASSET_ROOT=${OWE_ASSET_ROOT:-$OWE_ROOT/assets}
export OWE_SSI_DISK=${OWE_SSI_DISK:-$OWE_ROOT/images/ssi-openwhisk.raw}
export OWE_SSI_BASE_DISK=${OWE_SSI_BASE_DISK:-/home/xtl/start/hpca/private-master.raw}
export OWE_CXL_WS=${OWE_CXL_WS:-$OWE_ROOT/cxlfork-vms}

# Runtime resources are overrideable so a top-level source manifest can keep
# code and non-Git artifacts separate.  These defaults preserve the original
# Lux campaign exactly.
export OWE_HPCA_DIR=${OWE_HPCA_DIR:-/home/xtl/start/hpca}
export OWE_QEMU=${OWE_QEMU:-/home/xtl/qemu-9.0.90-clean/build/qemu-system-x86_64}
export OWE_KERNEL=${OWE_KERNEL:-/home/xtl/start/hpca-cxlfork/kernels/bzImage-6.6.32-cxlfork-91}
export OWE_KVM_LOADER=${OWE_KVM_LOADER:-$OWE_HPCA_DIR/load-native-kvm.sh}
export OWE_SSH_KEY=${OWE_SSH_KEY:-/home/xtl/start/hpca-cxlfork/keys/id_ed25519}
export OWE_CXL_BASE_IMAGE_ROOT=${OWE_CXL_BASE_IMAGE_ROOT:-/home/xtl/start/hpca-cxlfork/images}
export OWE_CLOUDINIT_ROOT=${OWE_CLOUDINIT_ROOT:-/home/xtl/start/hpca-cxlfork/cloudinit}
export OWE_RUNTIME_ROOT=${OWE_RUNTIME_ROOT:-/home/xtl/start/hpca-cxlfork}
export OWE_RUNTIME_OWNER=${OWE_RUNTIME_OWNER:-xtl:xtl}
export OWE_MIN_HOST_CPUS=${OWE_MIN_HOST_CPUS:-96}
export OWE_SHARED_BACKEND=${OWE_SHARED_BACKEND:-auto}
export OWE_BACKEND_HELPER=${OWE_BACKEND_HELPER:-}

export OWE_OPENWHISK_BASE=7ef091c12714b40d5dd93ff1488b086f0cebf3f8
export OWE_OPENWHISK_EVAL_COMMIT=1d113f65bf78e203dd7d98660dc7c2e99c0a3bdf
export OWE_JAR_SHA256=0b5b5ba4e79458b685beefcfc1984344715125798c89ddc5604e1f58a414e2c9
export OWE_WSK_SHA256=8e0a41b1cde74a02e4066e19421b22226d62ac3c375413aa84206948172f12b8
export OWE_JDK_MANIFEST_SHA256=71be2f01e5e8beebdc21345b654e3527dcac004c545575d9429288a1d958ef84
export OWE_WORKLOAD=state-scan-4m-v1
export OWE_STATE_BYTES=4194304
export OWE_STATE_CHECKSUM=05ae28486824d617

# All six systems use the same total-vCPU budget.  SSI puts the OpenWhisk
# platform on the first half and action containers on the second half.
# CXLfork gives the first half to VM0 and the second half to VM1.
export OWE_VCPUS="8 16 32 64 80"
export OWE_SYSTEMS=${OWE_SYSTEMS:-"cohort no-tiering starfish native-cxl native-dram cxlfork"}
export OWE_REPS=${OWE_REPS:-5}
export OWE_SEQUENTIAL_REQUESTS=${OWE_SEQUENTIAL_REQUESTS:-200}
export OWE_THROUGHPUT_SECONDS=${OWE_THROUGHPUT_SECONDS:-30}
export OWE_WARM_REFERENCE_VCPU=${OWE_WARM_REFERENCE_VCPU:-32}

# The workload touches only 4 MiB.  The distributed single-system launchers
# allocate one private pool per physical QEMU, so each gets 8 GiB.  Native has
# one 16 GiB VM, and CXLfork has two independent 8 GiB VMs.  All paths thus
# expose a 16 GiB total private-DRAM budget.
export OWE_GVM_LOCAL_MEMORY=8G
export OWE_NATIVE_MEMORY=16G
export OWE_CXL_VM_MEMORY=8G
# With an 8 GiB guest, QEMU places the 4 GiB NVDIMM at guest physical
# [0x280000000, 0x37f000000).  CXLfork intentionally skips the first 64 MiB
# label/header area, so its usable driver window starts at 0x284000000 and
# ends exactly with the NVDIMM data range.  These values must change together
# with OWE_CXL_VM_MEMORY if the guest memory layout is changed.
export OWE_CXL_PHYS=0x284000000
export OWE_CXL_SIZE=0xfb000000
export OWE_VM0_PORT=2200
export OWE_VM1_PORT=2201
export OWE_GUEST_PASSWORD=${OWE_GUEST_PASSWORD:-123}
export OWE_OPENWHISK_PORT=3233
export OWE_CXLPORTER_PORT=7100
export OWE_AUTH=${OWE_AUTH:-23bc46b1-71f6-4ed5-8c54-816aa4f8c502:123zO3xZCLrMN6v2BKK1dXYFpXlPkccOFqm12CdAsMgRU4VrNZ9lyGVCGuMDGIwP}

# Real-CXL geometry is inherited from config/real-cxl-103.env.  Only
# [4 GiB, 12 GiB) may be initialized by the scoped dax-admin helper.
export OWE_REAL_CXL_PROFILE=${OWE_REAL_CXL_PROFILE:-/home/xtl/cxlfork/openwhisk-state-action-eval/config/real-cxl-103.env}
export OWE_EXCLUSIVE_TOKEN=${OWE_EXCLUSIVE_TOKEN:-I_HAVE_EXCLUSIVE_KVM_DAX_103}
