# 10.0.16.103 上 HydraRPC + CXLfork + MR 的权威运行 profile。
# 用法：set -a; source config/real-cxl-103.env; set +a
# 本文件只设置变量，不切换 DAX、不清零设备、也不启动 VM。

export WS=/home/xtl/cxlfork/cxlfork-repro
export QEMU=/home/xtl/qemu-9.0.90-clean/build/qemu-system-x86_64
export MACHINE=pc-q35-8.2,kernel-irqchip=split,mem-merge=off
export GUEST_APPEND_EXTRA=nox2apic
export KERNEL=/home/xtl/start/hpca-cxlfork/kernels/bzImage-6.6.32-cxlfork-91
export KBUILD=/home/xtl/cxlfork/cxlfork-repro/kernel/build-6.6.32
export QEMU_SHA256=8ac0439e63ae69d73f82160c529687512b621c94ddf70e4ef8bf6237971036c0
export KERNEL_SHA256=ebc389f912a1ba7bbc9556b23fe136845b000eaced9f227398f99edbfcaea0d0
export VM0_BASE_IMAGE=/home/xtl/start/hpca-cxlfork/images/mr-vm0-base.qcow2
export VM1_BASE_IMAGE=/home/xtl/start/hpca-cxlfork/images/mr-vm1-base.qcow2
export VM0_BASE_IMAGE_SHA256=b7b4da0daad273ea3673623afb3875fd03c7f3aa9a1b2c92fde60d57715fd6b0
export VM1_BASE_IMAGE_SHA256=c43e4f0849f4b71d55279fb201cd05a3bcfde252fb96683e348880a9c1f51906
export VM0_SEED_SHA256=e26c2ab425e6de529ceb582d1da123152ff8f1717ebc7e61df05527a02681fc2
export VM1_SEED_SHA256=8e38d469b087477d33571e6bdf469631536c0f1322c4c4fb5b5a4ad56bbb8eb4

# 单个 64 GiB /dev/dax0.0 内的静态分区：
#   [4 GiB, 8 GiB)   CXLfork NVDIMM backend
#   [8 GiB, 10 GiB)  HydraRPC endpoint 0
#   [10 GiB, 12 GiB) HydraRPC endpoint 1
# [0,4 GiB) 和 [12,64 GiB) 不属于本实验，工具不得清零或写入。
export CXL_FILE=/dev/dax0.0
export CXL_BACKEND_OFFSET=4G
export CXL_BACKEND_SIZE=4G
export CXL_BACKEND_ALIGN=2M
export CXL_PHYS=0x484000000
export CXL_SIZE=0xfb000000

export HYDRA_SHM_FILE=/dev/dax0.0
export HYDRA_SHM_SIZE=12G
export HYDRA_BACKEND_OFFSET=8G
export HYDRA_ENDPOINT_SIZE=2G
export HYDRA_ENDPOINT1_OFFSET=2G
export HYDRA_BACKEND_ALIGN=2M
export BACKEND_RESET=none

export MEM=16G
export SMP=16
export VM0_HOST_CPUS=48-67
export VM1_HOST_CPUS=72-91
export VM_MEMORY_NODE=1
export HYDRA0_PCI_ADDR=0x2
export HYDRA1_PCI_ADDR=0x3

export VM0_PORT=2200
export VM1_PORT=2201
export VM1_CONTROL_PORT=2301
export SSH_KEY=/home/xtl/start/hpca-cxlfork/keys/id_ed25519
export HYDRARPC_ROOT=/home/xtl/cxlfork/HydraRPC
