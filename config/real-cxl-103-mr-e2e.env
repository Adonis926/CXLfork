# 103 上与单机 96-vCPU/40-GiB Motivation MR 实验对齐的双 VM profile。
# 先继承经过验证的真实 DAX 地址布局，只覆盖计算资源分配。
# 用法：set -a; source config/real-cxl-103-mr-e2e.env; set +a

profile_dir=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=real-cxl-103.env
source "$profile_dir/real-cxl-103.env"
unset profile_dir

# 与单 VM baseline 保持 96 个总 vCPU 和 40 GiB 总私有 DRAM：
# VM0 固定在 socket/node 0，VM1 固定在 socket/node 1，均只使用物理线程。
export SMP=48
export MEM=20G
export VM_MAXMEM=20G
export VM0_HOST_CPUS=0-47
export VM1_HOST_CPUS=48-95
export VM0_MEMORY_NODE=0
export VM1_MEMORY_NODE=1

# 固定正式 MR 规模，runner 可直接读取这些变量作为实验 manifest。
export MR_MAPPERS=48
export MR_REDUCERS_PARALLEL=48
export MR_PARTITIONS=128
export MR_MAP_CHUNK=2097152
export MR_PAYLOAD_MAX=4194304
export MR_SHUFFLE_CONNECTIONS=48
export MR_INPUT_BYTES=1073741824
export MR_INPUT_FILES=512
export MR_VOCAB=65536
export MR_LINE_WORDS=16
export MR_WARMUP=2
export MR_REPEAT=5
